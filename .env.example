# Copy this to .env and fill in real values
# Railway: add these as environment variables in your service settings

VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...   # Your Stripe publishable key (live or test)

# Server-side (already in Railway secrets)
# DATABASE_URL=postgresql://...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# JWT_SECRET=...
# RESEND_API_KEY=re_...

# ── Affiliate marketplace ─────────────────────────────────────────────
# Global kill switch. Default false/unset: GET /api/affiliate/listings
# returns [] so the affiliate section renders nothing anywhere, regardless
# of DB contents. Set to true ONLY once real affiliate accounts exist and
# real tracking tags are entered in Admin Portal → Affiliate Marketplace.
# AFFILIATE_MARKETPLACE_ENABLED=false

# Demo/dev seeding only. The affiliate demo seed (sample Amazon program +
# listings with a fake tag) runs ONLY when NODE_ENV != production AND this
# is explicitly true. Never set in production.
# SEED_DEMO_DATA=false
