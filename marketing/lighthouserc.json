{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/amazonsmile-alternative/index.html",
        "http://localhost/shop-local/mississippi/jackson/index.html",
        "http://localhost/learn/what-happened-to-amazonsmile/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["seo", "performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
