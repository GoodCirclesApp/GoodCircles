---
// Base layout: one head manager for every page.
// Guarantees per-route: unique title/description, self-referencing canonical,
// absolute-URL OG/Twitter tags (title === og:title), site-wide Organization +
// WebSite JSON-LD, optional page-level JSON-LD blocks, optional noindex.
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/montserrat/900.css';
import '@fontsource/fira-sans/400.css';
import '@fontsource/fira-sans/500.css';
import '@fontsource/fira-sans/600.css';
import '@fontsource/fira-sans/700.css';
import '../styles/global.css';
import { SITE_NAME, ORGANIZATION_JSONLD, WEBSITE_JSONLD, GA4_MEASUREMENT_ID, absoluteUrl } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Route path beginning with "/", used for the canonical + og:url. */
  path: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD blocks for this page (FAQPage, Article, BreadcrumbList, …). */
  jsonLd?: object[];
}

const { title, description, path, ogType = 'website', noindex = false, jsonLd = [] } = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl('/og.png');
const GA4_ID = (import.meta.env.PUBLIC_GA4_ID as string | undefined) ?? GA4_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#7851A9" />
    <link rel="icon" type="image/svg+xml" href="/brand/gc-submark-fullcolor.svg" />
    <link rel="icon" type="image/png" href="/logos/submark-gold-48.png" />
    <link rel="manifest" href="/manifest.json" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — Learn & Nonprofit Answers`}
      href="/rss.xml"
    />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph (title intentionally identical to <title>) -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Site-wide entity schema -->
    <script type="application/ld+json" set:html={JSON.stringify(ORGANIZATION_JSONLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(WEBSITE_JSONLD)} />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {GA4_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
        <script
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA4_ID}');document.addEventListener('click',function(e){if(!(e.target&&e.target.closest))return;var c=e.target.closest('[data-cta-audience]');if(c)gtag('event','cta_click',{audience:c.getAttribute('data-cta-audience'),page:location.pathname});var p=e.target.closest('[data-affiliate]');if(p)gtag('event','partner_click',{partner:p.getAttribute('data-affiliate'),page:location.pathname});});`}
        />
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
