---
// Flagship Ring-1 comparison hub — "best AmazonSmile alternative in 2026".
// Rebuilt on the answer-first AnswerPage layout: data-file-driven comparison table
// (AS_ALTERNATIVES) + Article + FAQPage + ItemList schema. AmazonSmile facts are
// sourced; competitor SUPERIORITY / "~8×" claims are [REVIEW]-gated. Canonical
// economics from data/economics.ts.
import AnswerPage from '../layouts/AnswerPage.astro';
import { PER_100, AMAZONSMILE, dollars } from '../data/economics';
import { AS_ALTERNATIVES } from '../data/amazonsmile-competitors';
import { itemListJsonLd, type Faq } from '../lib/faq';
import { SITE_URL } from '../data/site';

const PATH = '/amazonsmile-alternative/';

const TITLE = 'Best AmazonSmile Alternative in 2026 — Save ~10% & Give Local';
const DESCRIPTION =
  'The best AmazonSmile alternative in 2026, compared. Most options donate a small percentage; Good Circles is local-first — you save ~10% AND ~$4 of every $100 funds a nonprofit you choose.';

const FAQS: Faq[] = [
  {
    q: 'What is the best AmazonSmile alternative in 2026?',
    a: 'It depends on what you want. For a national shopping-portal replacement, ShopRaise, Givebacks, and iGive work much like AmazonSmile did. If you want to save money AND give more AND keep it local, Good Circles is the strongest option: you save about 10% at local businesses and about $4 of every $100 funds a nonprofit you choose, from the merchant’s profit.',
  },
  {
    q: 'How is Good Circles different from AmazonSmile?',
    a: `AmazonSmile gave about ${AMAZONSMILE.ratePercent}% from Amazon purchases with no shopper benefit. Good Circles is local-first: you save about 10%, and about $${PER_100.nonprofit} of every $100 funds a nonprofit you choose — while the local business keeps 89% of its profit.`,
  },
  {
    q: 'Does it cost anything to join?',
    a: 'No. Joining is free for shoppers and nonprofits. Local businesses pay only a 1% fee on profit — there are no membership or subscription fees.',
  },
  {
    q: 'When does Good Circles launch?',
    a: 'Early access is underway in Meridian and Lauderdale County. Good Circles launches on schedule in September 2026 in the Jackson, Mississippi metro, then expands across Mississippi and to the cities that request it most.',
  },
];

const SOURCES = [
  { label: 'NPR — Amazon ends AmazonSmile', url: 'https://www.npr.org/2023/01/19/1149993013/amazon-amazonsmile-charity-donation-program' },
  { label: 'Charity Navigator — End of AmazonSmile', url: 'https://www.charitynavigator.org/about-us/news-thought-leadership/end-of-amazonsmile/' },
  { label: 'DonorDock — AmazonSmile replacement options', url: 'https://www.donordock.com/articles/amazonsmile-replacement-options' },
];

const LIST = itemListJsonLd(
  AS_ALTERNATIVES.map((a) => ({ name: a.name, url: a.url, description: a.model })),
  'AmazonSmile alternatives (2026)',
);
const yn = (b: boolean) => (b ? 'Yes' : 'No');
---

<AnswerPage
  title={TITLE}
  description={DESCRIPTION}
  path={PATH}
  eyebrow="Updated July 2026"
  badge="Early access in Meridian · September 2026 launch, Jackson metro"
  question="What's the best AmazonSmile alternative in 2026?"
  directAnswer={`<strong>It depends on what you want.</strong> For a national shopping-portal replacement, ShopRaise, Givebacks, and iGive work much like AmazonSmile did. But if you want to <strong>save money AND give more AND keep it local</strong>, <strong>Good Circles</strong> is the strongest option: you save about 10% at local businesses, and about <strong>$${PER_100.nonprofit} of every $100</strong> funds a nonprofit you choose — from the merchant's profit, at no extra cost.`}
  lastUpdated="2026-07-09"
  faqs={FAQS}
  sources={SOURCES}
  breadcrumbs={[{ name: 'AmazonSmile alternative', url: `${SITE_URL}${PATH}` }]}
  extraJsonLd={[LIST]}
>
  <Fragment slot="ctas">
    <a href="/#mirror-section" data-cta-audience="NEIGHBOR" class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider" style="background:#C2A76F;color:#241247">
      Pick your nonprofit and join free →
    </a>
  </Fragment>

  <h2>What happened to AmazonSmile?</h2>
  <p>
    Amazon shut down AmazonSmile in <strong>{AMAZONSMILE.ended}</strong>. Over roughly a decade it donated about
    <strong>${AMAZONSMILE.lifetimeMillions} million</strong> globally and enrolled more than a million nonprofits —
    but only at a <strong>{AMAZONSMILE.ratePercent}%</strong> rate, only on Amazon, with no relationship between you
    and the cause. When it ended, millions of shoppers and nonprofits lost the easiest way they had to give. The
    habit didn't disappear — the tool did.
  </p>

  <h2>AmazonSmile alternatives in 2026, compared</h2>
  <p>
    Most replacements work like AmazonSmile did: a small percentage of your spending goes to a nonprofit, at no cost
    to you. The two things almost none of them do — <strong>also save the shopper money</strong>, and
    <strong>keep the giving local</strong> — are exactly where a local-first model is different.
  </p>
  <div style="overflow-x:auto">
    <table style="width:100%;border-collapse:collapse;font-size:0.92rem">
      <thead>
        <tr style="background:#F0EBFF">
          <th style="text-align:left;padding:9px">Service</th>
          <th style="text-align:left;padding:9px">Nonprofit gets</th>
          <th style="text-align:center;padding:9px">You also save?</th>
          <th style="text-align:center;padding:9px">Local-first?</th>
        </tr>
      </thead>
      <tbody>
        {AS_ALTERNATIVES.map((a) => (
          <tr style={`border-bottom:1px solid #E7DCF2;${a.isGoodCircles ? 'background:#FBF7FE' : ''}`}>
            <td style="padding:9px;font-weight:800">
              {a.url ? <a href={a.url} rel="nofollow noopener">{a.name}</a> : a.name}
            </td>
            <td style="padding:9px">{a.givingRate}{!a.rateVerified && <span style="color:#8a83a0"> *</span>}</td>
            <td style={`padding:9px;text-align:center;font-weight:700;${a.shopperSaves ? 'color:#059669' : 'color:#b91c1c'}`}>{yn(a.shopperSaves)}</td>
            <td style={`padding:9px;text-align:center;font-weight:700;${a.localFirst ? 'color:#059669' : 'color:#b91c1c'}`}>{yn(a.localFirst)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p style="font-size:0.82rem;color:#8a83a0">
    * Per-retailer giving rates vary by store/brand and change over time; figures shown as “varies” are not a fixed
    percentage. See each provider for current rates. (Good Circles’ figure is 10% of the merchant’s profit.)
  </p>

  <h2>Why a local-first model is different</h2>
  <p>
    AmazonSmile asked you to give a tiny slice of an Amazon purchase. Good Circles changes the whole equation: you
    shop <strong>local</strong>, you <strong>save about 10%</strong>, and about <strong>{dollars(PER_100.nonprofit)} of
    every $100</strong> funds a nonprofit you choose. On top of that, about <strong>${PER_100.localRecirculation}</strong>
    of every $100 stays circulating in your local economy versus about <strong>${PER_100.chainRecirculation}</strong>
    at a national chain (Civic Economics). Same money, better math.
  </p>
    <p>
      Put another way: AmazonSmile gave about {AMAZONSMILE.ratePercent}% per purchase; Good Circles' model directs
      about ${PER_100.nonprofit} per $100 — on the order of <strong>{AMAZONSMILE.giveMultipleVsGoodCircles}× the
      per-dollar giving rate</strong>, and it keeps the money local while paying the shopper.
      <em>(Comparative estimate — see methodology.)</em>
    </p>

  <h2>How it works (3 steps, ~3 minutes)</h2>
  <ol>
    <li><strong>Sign up free</strong> at goodcircles.org — no app to download.</li>
    <li><strong>Pick your nonprofit</strong> — any IRS-verified 501(c)(3). Change it anytime.</li>
    <li><strong>Shop local.</strong> Prices already show ~10% lower, and a share of every sale funds your cause — automatically.</li>
  </ol>

  <h2>Lost AmazonSmile for your nonprofit?</h2>
  <p>
    If your organization relied on AmazonSmile, Good Circles replaces it with <strong>recurring, no-cost funding</strong> —
    and supporters who actually save money. See <a href="/for-nonprofits/">Good Circles for Nonprofits →</a>, or read
    <a href="/learn/what-replaced-amazonsmile/">what replaced AmazonSmile</a>.
  </p>
</AnswerPage>
