---
// Nonprofit pillar. Copy: GoodCircles_SEO_PageCopy.md PAGE 3 (verbatim).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqJsonLd, type Faq } from '../lib/faq';
import { serviceJsonLd } from '../data/site';

const SERVICE = serviceJsonLd({
  name: 'Free passive fundraising for nonprofits',
  serviceType: 'Nonprofit fundraising',
  description:
    'Free, recurring fundraising: supporters pick your nonprofit once, and 10% of the merchant’s profit on every local purchase they make is routed to you automatically each month. No fees, no campaigns.',
  free: true,
});

const TITLE = 'Free Passive Fundraising for Nonprofits — AmazonSmile Alternative';
const DESCRIPTION =
  'Get recurring, no-cost funding every time your supporters shop local. No grant writing, no galas. Claim your Founding Nonprofit spot free.';

const FAQS: Faq[] = [
  {
    q: 'How does a nonprofit raise money on Good Circles?',
    a: 'Supporters select your nonprofit once. From then on, 10% of the merchant’s profit on every local purchase they make is routed to you automatically each month — no campaigns, no fees.',
  },
  {
    q: 'Is it really free for nonprofits?',
    a: 'Yes. There’s no cost to join and no fee on distributions. Good Circles is funded by a 1% fee businesses pay on profit.',
  },
  {
    q: 'How is this different from AmazonSmile?',
    a: 'AmazonSmile gave 0.5% from Amazon purchases and shut down in 2023. Good Circles routes 10% of local merchants’ profit to the cause each supporter chooses, and keeps the money local.',
  },
];
---

<Base title={TITLE} description={DESCRIPTION} path="/for-nonprofits" jsonLd={[faqJsonLd(FAQS), SERVICE]}>
  <Nav solid />
  <main id="main">
    <PageHero
      eyebrow="For nonprofits"
      badge="Only the first 50 nonprofits become Founding Nonprofits"
      h1="Get funded every time your supporters shop"
    >
      <p slot="answer">
        Good Circles is free, recurring fundraising for your nonprofit. Supporters pick your cause
        once, then <strong>10% of the merchant's profit</strong> on every local purchase they make
        is routed to you — <strong>automatically, every month</strong>. No grant writing, no
        galas, no fees. It's the local AmazonSmile alternative.
      </p>
      <Fragment slot="ctas">
        <a
          href="/#mirror-section"
          data-cta-audience="NONPROFIT"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider"
          style="background:#C2A76F;color:#241247"
        >
          Claim your Founding Nonprofit spot (free) →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          How it works
        </h2>
        <ol class="mb-12 space-y-4" style="font-family:'Fira Sans',sans-serif">
          <li class="flex gap-4">
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-black text-white" style="background:#A20021">1</span>
            <p class="text-slate-600 leading-relaxed"><strong>Sign up free</strong> with your EIN — IRS-verified 501(c)(3)s only, about 3 minutes.</p>
          </li>
          <li class="flex gap-4">
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-black text-white" style="background:#A20021">2</span>
            <p class="text-slate-600 leading-relaxed"><strong>Your supporters choose you</strong> as their cause inside Good Circles.</p>
          </li>
          <li class="flex gap-4">
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-black text-white" style="background:#A20021">3</span>
            <p class="text-slate-600 leading-relaxed"><strong>You get paid monthly</strong> — a share of every purchase they make, with zero effort from you.</p>
          </li>
        </ol>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          What it earns
        </h2>
        <div class="p-8 rounded-3xl mb-12" style="background:#FBF7FE;border:1px solid #E7DCF2">
          <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
            About <strong>$72 per supporter per year</strong>. That means <strong>500 supporters
            ≈ $36,000 a year</strong> — recurring, unrestricted, with no campaign to run and no
            extra spending from your donors.
          </p>
        </div>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Better than AmazonSmile ever was
        </h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          AmazonSmile gave 0.5% from Amazon and then disappeared. Good Circles routes <strong>10%
          of local merchants' profit</strong> to the causes your supporters choose, keeps the money
          in your community, and isn't going anywhere. It's built to replace what nonprofits
          lost — and improve on it. More on
          <a href="/amazonsmile-alternative/" class="font-bold underline" style="color:#7851A9">the AmazonSmile alternative »</a>
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Be a Founding Nonprofit
        </h2>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          Only the <strong>first 50 nonprofits</strong> become Founding Nonprofits — a permanent
          badge and homepage feature. After that, the founding spots are gone.
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Nonprofit FAQ" />

    <CtaBand
      heading="Claim your Founding Nonprofit spot"
      text="Free to join, no fee on distributions. Only the first 50 nonprofits get founding status."
      label="Claim your spot (free) →"
      href="/#mirror-section"
      audience="NONPROFIT"
      secondaryLabel="How it works"
      secondaryHref="/how-it-works/"
    />

    <section class="py-12 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-black uppercase tracking-widest mb-4" style="color:#C2A76F">Fundraising for your kind of organization</p>
        <div class="grid sm:grid-cols-2 gap-3">
          <a href="/for-nonprofits/for-schools/" class="block p-4 rounded-xl no-underline" style="background:#FBF7FE;border:1px solid #E7DCF2">
            <p class="font-black text-slate-900">No-cost fundraising for schools ›</p>
          </a>
          <a href="/for-nonprofits/for-churches/" class="block p-4 rounded-xl no-underline" style="background:#FBF7FE;border:1px solid #E7DCF2">
            <p class="font-black text-slate-900">Free fundraising for churches ›</p>
          </a>
          <a href="/for-nonprofits/for-sports-teams/" class="block p-4 rounded-xl no-underline" style="background:#FBF7FE;border:1px solid #E7DCF2">
            <p class="font-black text-slate-900">Fundraising for sports teams ›</p>
          </a>
          <a href="/for-nonprofits/for-clubs/" class="block p-4 rounded-xl no-underline" style="background:#FBF7FE;border:1px solid #E7DCF2">
            <p class="font-black text-slate-900">Fundraising for clubs & groups ›</p>
          </a>
        </div>
        <p class="mt-6 text-sm" style="font-family:'Fira Sans',sans-serif">
          <strong class="text-slate-900">Related:</strong>
          <a href="/amazonsmile-alternative/" class="ml-3 underline" style="color:#7851A9">AmazonSmile alternative</a><a href="/for-nonprofits/founding-nonprofit/" class="ml-3 underline" style="color:#7851A9">Become a Founding Nonprofit</a><a href="/learn/passive-nonprofit-funding/" class="ml-3 underline" style="color:#7851A9">Passive nonprofit funding guide</a>
          <a href="/how-it-works/" class="ml-3 underline" style="color:#7851A9">How it works</a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
