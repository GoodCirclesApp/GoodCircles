---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { faqJsonLd, breadcrumbJsonLd, type Faq } from '../../lib/faq';
import { SITE_URL } from '../../data/site';
import { CAUSES, type Cause } from '../../data/causes';

export function getStaticPaths() {
  return CAUSES.map((cause) => ({ params: { slug: cause.slug }, props: { cause } }));
}

interface Props {
  cause: Cause;
}
const { cause } = Astro.props;
const path = `/causes/${cause.slug}/`;
const TITLE = `Support ${cause.titleNoun} Nonprofits · Good Circles`;
const DESCRIPTION = `Fund ${cause.name.toLowerCase()} nonprofits every time you shop local — save ~10% and send a share of every sale to the cause you choose, at no extra cost.`;
const faqs: Faq[] = cause.faqs;

// ItemList enumerates example nonprofit TYPES within the cause (accurate — not
// fabricated organizations).
const ITEMLIST_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Types of ${cause.name.toLowerCase()} nonprofits you can fund with Good Circles`,
  itemListElement: cause.exampleTypes.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t,
  })),
};
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path={path}
  jsonLd={[
    faqJsonLd(faqs),
    ITEMLIST_JSONLD,
    breadcrumbJsonLd([
      { name: 'Home', url: `${SITE_URL}/` },
      { name: 'Causes', url: `${SITE_URL}/causes/` },
      { name: cause.name, url: `${SITE_URL}${path}` },
    ]),
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="Causes" h1={cause.h1}>
      <p slot="answer" set:html={cause.answerHtml} />
      <Fragment slot="ctas">
        <a href="/#mirror-section" data-cta-audience="NEIGHBOR" class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider" style="background:#C2A76F;color:#241247">
          Pick your nonprofit and join free →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Why fund {cause.name.toLowerCase()} this way
        </h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif" set:html={cause.whyHtml} />

        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          {cause.name} nonprofits you can support
        </h2>
        <p class="text-slate-500 mb-6" style="font-family:'Fira Sans',sans-serif">
          Choose any IRS-verified 501(c)(3) in this space — for example:
        </p>
        <ul class="grid sm:grid-cols-2 gap-3 mb-12">
          {cause.exampleTypes.map((t) => (
            <li class="p-4 rounded-xl text-slate-700" style="background:#FBF7FE;border:1px solid #E7DCF2;font-family:'Fira Sans',sans-serif">
              {t}
            </li>
          ))}
        </ul>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">How it works</h2>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          Sign up free, pick your cause once, and shop local. You save about 10%, the business
          keeps 89% of its profit, and 10% of that profit funds the nonprofit you chose —
          automatically, at no extra cost. See the full breakdown on
          <a href="/how-it-works/" class="font-bold underline" style="color:#7851A9">how it works »</a>
          or browse <a href="/causes/" class="font-bold underline" style="color:#7851A9">all causes »</a>
        </p>
      </div>
    </section>

    <FaqList faqs={faqs} heading={`${cause.titleNoun} FAQ`} />

    <CtaBand
      heading={`Fund ${cause.name.toLowerCase()} every time you shop`}
      text="Free for shoppers and nonprofits. Early access in Meridian — September 2026 launch, Jackson metro first."
      label="Pick your nonprofit and join free →"
      href="/#mirror-section"
      audience="NEIGHBOR"
      secondaryLabel="How it works"
      secondaryHref="/how-it-works/"
    />
  </main>
  <Footer />
</Base>
