---
// /sell/booksy — switch page for barbers/salons on Booksy. Static
// (subscription/booking model). Verified 2026-06-22 (biz.booksy.com/en-us/pricing):
// $29.99/mo (+$20/team member) + ~2.69% + $0.30 processing; optional "Boost"
// charges a one-time 30% fee on a Boost-acquired client's first visit (capped $100).
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import FaqList from "../../components/FaqList.astro";
import CtaBand from "../../components/CtaBand.astro";
import SubscriptionCalculator from "../../components/SubscriptionCalculator.astro";
import { faqJsonLd, breadcrumbJsonLd, type Faq } from "../../lib/faq";
import { SITE_URL } from "../../data/site";
import { goodCircles, subscriptionBooking } from "../../data/sell-competitors";

const TITLE = "Booksy Alternative for Barbers & Salons (2026) · Good Circles";
const DESCRIPTION =
  "Booksy charges a monthly fee plus processing, and its Boost program takes ~30% of a new client's first visit. Good Circles brings new local clients at no acquisition fee, with a 1% fee on profit.";

const g = goodCircles(100, 30, 0.25); // $100 service, $30 cost, 25% tax
const bk = subscriptionBooking(100, 30, { monthlySub: 29.99, procPct: 2.69, procFixed: 0.3, newClientPct: 30, newClientCap: 100, bookingsPerMonth: 60 }, 0.25);

const FAQS: Faq[] = [
  {
    q: "How does Booksy charge businesses?",
    a: "Booksy charges about $29.99/month (plus ~$20 per additional team member) and payment processing (~2.69% + $0.30). Its optional Boost program, which markets you to new clients, takes a one-time 30% of a Boost-acquired client's first visit, capped at $100. Repeat clients only cost processing; the cost is the subscription and Boost's new-client fee.",
  },
  {
    q: "Will I keep more on Good Circles than Booksy?",
    a: "For repeat clients, Booksy's per-visit cash is similar - Good Circles passes ~10% to your customer, which Booksy doesn't. The difference is new clients: Boost takes up to $100 of a new client's first visit, while Good Circles brings new local clients at no acquisition fee. On a $100 first visit via Boost you keep about $40 after tax on Good Circles versus about $27 on Booksy, with no monthly subscription.",
  },
  {
    q: "Can I use Booksy and Good Circles together?",
    a: "Yes. Keep Booksy for your calendar and regulars if you like it, and use Good Circles as the channel that brings new local clients - without a 30% first-visit Boost fee, with customers saving ~10%, and a local nonprofit funded on every appointment. Good Circles is free to join with a 1% fee on profit.",
  },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/sell/booksy"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    breadcrumbJsonLd([
      { name: "Home", url: `${SITE_URL}/` },
      { name: "Sell", url: `${SITE_URL}/sell/` },
      { name: "Booksy alternative", url: `${SITE_URL}/sell/booksy/` },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: "Booksy alternative for barbers and salons (2026)",
      description: DESCRIPTION,
      datePublished: "2026-06-23",
      dateModified: "2026-06-23",
      author: { "@type": "Organization", name: "Good Circles" },
      publisher: { "@type": "Organization", name: "Good Circles", logo: { "@type": "ImageObject", url: `${SITE_URL}/og.png` } },
      mainEntityOfPage: `${SITE_URL}/sell/booksy/`,
    },
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero
      eyebrow="Switch from Booksy"
      badge="First 200 Mississippi businesses are Founding Merchants"
      h1="Booksy's Boost takes ~30% of a new client's first visit. Good Circles takes 1% of profit."
    >
      <p slot="answer">
        Booksy is cheap for your regulars — but it charges a <strong>monthly subscription</strong> and its Boost program
        takes <strong>30% of a new client's first visit</strong> (capped $100), which is the customer it's meant to find
        you. Good Circles brings <strong>new local clients at no acquisition fee</strong>, with <strong>no subscription</strong>,
        a <strong>1% fee on profit</strong>, your customer <strong>saving ~10%</strong>, and a local nonprofit funded.
        Free to join.
      </p>
      <Fragment slot="ctas">
        <a href="/#mirror-section" data-cta-audience="MERCHANT" class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider" style="background:#C2A76F;color:#241247">
          Become a Founding Merchant (free) →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">A $100 service, side by side</h2>
        <p class="text-slate-600 leading-relaxed mb-8" style="font-family:'Fira Sans',sans-serif">
          A $100 service that costs you $30 to deliver, at a 25% tax rate, assuming 60 bookings a month. The gap is on
          the <strong>new</strong> client — the one Boost charges you ${bk.newClientFee.toFixed(2)} to land.
        </p>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm" style="border-collapse:collapse">
            <thead>
              <tr style="background:#faf7fd">
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Per service</th>
                <th class="text-left p-3 font-black text-xs uppercase tracking-wider" style="color:#7851A9">Good Circles</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Booksy (repeat)</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Booksy (Boost new client)</th>
              </tr>
            </thead>
            <tbody style="font-family:'Fira Sans',sans-serif">
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Customer pays</td><td class="p-3 font-bold" style="color:#241247">${g.customerPays.toFixed(2)} (saves ${g.customerSaves.toFixed(2)})</td><td class="p-3 text-slate-500">$100.00</td><td class="p-3 text-slate-500">$100.00</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Cost to deliver</td><td class="p-3 font-bold" style="color:#241247">($30.00)</td><td class="p-3 text-slate-500">($30.00)</td><td class="p-3 text-slate-500">($30.00)</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Processing · subscription / booking</td><td class="p-3 font-bold" style="color:#241247">$0 · $0</td><td class="p-3 text-slate-500">(${bk.processing.toFixed(2)}) · (${bk.subPerBooking.toFixed(2)})</td><td class="p-3 text-slate-500">(${bk.processing.toFixed(2)}) · (${bk.subPerBooking.toFixed(2)})</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Boost new-client fee (first visit)</td><td class="p-3 font-bold" style="color:#241247">—</td><td class="p-3 text-slate-500">—</td><td class="p-3 text-slate-500">(${bk.newClientFee.toFixed(2)})</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Good Circles fee · donation</td><td class="p-3 font-bold" style="color:#241247">(${g.platformFee.toFixed(2)}) · (${g.donation.toFixed(2)})</td><td class="p-3 text-slate-500">—</td><td class="p-3 text-slate-500">—</td></tr>
              <tr style="border-top:2px solid #cbd5e1"><td class="p-3 font-black text-slate-900">Pre-tax profit</td><td class="p-3 font-black" style="color:#241247">${g.preTaxProfit.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${bk.preTaxReturning.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${bk.preTaxNew.toFixed(2)}</td></tr>
              <tr style="background:#f7f3fc"><td class="p-3 font-black text-slate-900">After-tax profit (25%)</td><td class="p-3 font-black" style="color:#241247">${g.afterTaxProfit.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${bk.afterTaxReturning.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${bk.afterTaxNew.toFixed(2)}</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 text-slate-500 text-xs">Customer saves / community funded</td><td class="p-3 text-slate-500 text-xs">${g.customerSaves.toFixed(2)} / ${g.donation.toFixed(2)}</td><td class="p-3 text-slate-500 text-xs">$0 / $0</td><td class="p-3 text-slate-500 text-xs">$0 / $0</td></tr>
              <tr style="background:#f7f3fc"><td class="p-3 font-black text-slate-900">Total local value created</td><td class="p-3 font-black" style="color:#241247">${g.totalLocalValue.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${bk.totalValueReturning.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${bk.totalValueNew.toFixed(2)}</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-[11px] text-slate-400" style="font-family:'Fira Sans',sans-serif">
          Booksy terms reported/verified 2026-06-22 (biz.booksy.com): ~$29.99/mo (${bk.subscriptionPerYear.toFixed(0)}/yr,
          +$20/team member) + ~2.69% + $0.30 processing + optional Boost (one-time 30% on a Boost-acquired client's
          first visit, capped $100). Good Circles has no subscription, no merchant card cost (the customer pays
          processing if they use a card), and no acquisition fee. Illustration, not tax advice.
        </p>
      </div>
    </section>

    <SubscriptionCalculator defaultKey="booksy" heading="Run your shop's numbers" />

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Great for your regulars — pricey for growth
        </h2>
        <p class="text-slate-600 leading-relaxed mb-6" style="font-family:'Fira Sans',sans-serif">
          Booksy is a capable booking app, and for the clients already in your chair it's inexpensive. But growth runs
          through Boost, and Boost takes up to $100 of a new client's first visit — you pay the most for exactly the
          customers you're trying to win.
        </p>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          Good Circles brings new local clients through nonprofits and their supporters at no acquisition fee, with no
          subscription, your customer saving ~10%, and a local cause funded. Keep Booksy for scheduling if you like it —
          let Good Circles grow your book. See
          <a href="/sell/marketplace-fees-comparison" class="font-bold underline" style="color:#7851A9">the full comparison &raquo;</a>
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Booksy vs Good Circles — FAQ" />

    <CtaBand
      heading="Grow your book without a 30% first-visit fee"
      text="Free to join. A 1% fee on profit only when you sell. The first 200 Mississippi businesses are Founding Merchants."
      label="Become a Founding Merchant (free) →"
      href="/#mirror-section"
      audience="MERCHANT"
      secondaryLabel="Compare every platform"
      secondaryHref="/sell/marketplace-fees-comparison"
    />
  </main>
  <Footer />
</Base>
