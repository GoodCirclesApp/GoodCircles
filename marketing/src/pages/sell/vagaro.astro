---
// /sell/vagaro — switch/complement page for salons on Vagaro. Static
// (subscription/booking model). Verified 2026-06-22 (vagaro.com/pro/pricing):
// $30/mo (+$10/employee, cap $90) + ~2.6% + $0.10 processing; NO new-client fee.
// Honest angle: Vagaro is a low-cost booking TOOL, not a customer channel — for a
// repeat client its per-visit cost is lower than Good Circles (which passes ~10%
// to the customer). Good Circles' value is bringing NEW local clients at no
// acquisition fee, plus customer savings + community, with no subscription.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import FaqList from "../../components/FaqList.astro";
import CtaBand from "../../components/CtaBand.astro";
import SubscriptionCalculator from "../../components/SubscriptionCalculator.astro";
import { faqJsonLd, breadcrumbJsonLd, type Faq } from "../../lib/faq";
import { SITE_URL } from "../../data/site";
import { goodCircles, subscriptionBooking } from "../../data/sell-competitors";

const TITLE = "Vagaro Alternative to Find New Local Clients (2026) · Good Circles";
const DESCRIPTION =
  "Vagaro is a low-cost booking tool, but it doesn't bring you customers and costs ~$360/year. Good Circles brings new local clients at no acquisition fee, with a 1% fee on profit and customers saving ~10%.";

const g = goodCircles(100, 30, 0.25); // $100 service, $30 cost, 25% tax
const vg = subscriptionBooking(100, 30, { monthlySub: 30, procPct: 2.6, procFixed: 0.1, newClientPct: 0, newClientCap: 0, bookingsPerMonth: 60 }, 0.25);

const FAQS: Faq[] = [
  {
    q: "How does Vagaro charge?",
    a: "Vagaro charges about $30/month (plus ~$10 per additional employee, capped around $90) and payment processing of roughly 2.6% + $0.10. Unlike StyleSeat or Booksy, it doesn't charge a new-client fee or a commission - it's priced as booking and management software.",
  },
  {
    q: "Is Good Circles cheaper than Vagaro per booking?",
    a: "Honestly, not for a client you already have - Vagaro's per-visit cost is low, and Good Circles passes ~10% to your customer, so your per-booking cash can be a little lower on Good Circles. The real difference is what each one does: Vagaro is booking software that doesn't bring you customers, while Good Circles is a channel that brings new local clients at no acquisition fee, with your customer saving ~10% and a local nonprofit funded. Many businesses use both.",
  },
  {
    q: "So should I drop Vagaro?",
    a: "Not necessarily. If Vagaro works as your calendar and payment tool, keep it. Add Good Circles as the channel that brings new local clients - with no subscription, no acquisition fee, customers saving ~10%, and a local cause funded on every sale. Good Circles is free to join with a 1% fee on profit.",
  },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/sell/vagaro"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    breadcrumbJsonLd([
      { name: "Home", url: `${SITE_URL}/` },
      { name: "Sell", url: `${SITE_URL}/sell/` },
      { name: "Vagaro alternative", url: `${SITE_URL}/sell/vagaro/` },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: "Vagaro alternative to find new local clients (2026)",
      description: DESCRIPTION,
      datePublished: "2026-06-23",
      dateModified: "2026-06-23",
      author: { "@type": "Organization", name: "Good Circles" },
      publisher: { "@type": "Organization", name: "Good Circles", logo: { "@type": "ImageObject", url: `${SITE_URL}/og.png` } },
      mainEntityOfPage: `${SITE_URL}/sell/vagaro/`,
    },
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero
      eyebrow="Already on Vagaro?"
      badge="First 200 Mississippi businesses are Founding Merchants"
      h1="Vagaro books your regulars. Good Circles brings you new local clients."
    >
      <p slot="answer">
        We'll be straight with you: Vagaro is a solid, low-cost booking tool, and for a client you already have its
        per-visit cost is lower than Good Circles (which passes <strong>~10% back to your customer</strong>). What Vagaro
        <em>doesn't</em> do is bring you customers — and it's a <strong>~$360/year</strong> subscription regardless. Good
        Circles is a <strong>customer channel</strong>: new local clients at <strong>no acquisition fee</strong>, no
        subscription, a <strong>1% fee on profit</strong>, and a local nonprofit funded. Use them together.
      </p>
      <Fragment slot="ctas">
        <a href="/#mirror-section" data-cta-audience="MERCHANT" class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider" style="background:#C2A76F;color:#241247">
          Become a Founding Merchant (free) →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">A $100 service, side by side</h2>
        <p class="text-slate-600 leading-relaxed mb-8" style="font-family:'Fira Sans',sans-serif">
          A $100 service that costs you $30 to deliver, at a 25% tax rate, 60 bookings a month. For a repeat client
          Vagaro keeps you a little more per visit — but it doesn't bring you the client, and Good Circles turns each
          sale into customer savings and community funding.
        </p>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm" style="border-collapse:collapse">
            <thead>
              <tr style="background:#faf7fd">
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Per service</th>
                <th class="text-left p-3 font-black text-xs uppercase tracking-wider" style="color:#7851A9">Good Circles</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Vagaro</th>
              </tr>
            </thead>
            <tbody style="font-family:'Fira Sans',sans-serif">
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Customer pays</td><td class="p-3 font-bold" style="color:#241247">${g.customerPays.toFixed(2)} (saves ${g.customerSaves.toFixed(2)})</td><td class="p-3 text-slate-500">$100.00</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Cost to deliver</td><td class="p-3 font-bold" style="color:#241247">($30.00)</td><td class="p-3 text-slate-500">($30.00)</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Processing · subscription / booking</td><td class="p-3 font-bold" style="color:#241247">$0 · $0</td><td class="p-3 text-slate-500">(${vg.processing.toFixed(2)}) · (${vg.subPerBooking.toFixed(2)})</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 font-bold text-slate-900">Good Circles fee · donation</td><td class="p-3 font-bold" style="color:#241247">(${g.platformFee.toFixed(2)}) · (${g.donation.toFixed(2)})</td><td class="p-3 text-slate-500">—</td></tr>
              <tr style="border-top:2px solid #cbd5e1"><td class="p-3 font-black text-slate-900">Pre-tax profit</td><td class="p-3 font-black" style="color:#241247">${g.preTaxProfit.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${vg.preTaxReturning.toFixed(2)}</td></tr>
              <tr style="background:#f7f3fc"><td class="p-3 font-black text-slate-900">After-tax profit (25%)</td><td class="p-3 font-black" style="color:#241247">${g.afterTaxProfit.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${vg.afterTaxReturning.toFixed(2)}</td></tr>
              <tr style="border-bottom:1px solid #E7DCF2"><td class="p-3 text-slate-500 text-xs">Customer saves / community funded</td><td class="p-3 text-slate-500 text-xs">${g.customerSaves.toFixed(2)} / ${g.donation.toFixed(2)}</td><td class="p-3 text-slate-500 text-xs">$0 / $0</td></tr>
              <tr style="background:#f7f3fc"><td class="p-3 font-black text-slate-900">Total local value created</td><td class="p-3 font-black" style="color:#241247">${g.totalLocalValue.toFixed(2)}</td><td class="p-3 font-black text-slate-600">${vg.afterTaxReturning.toFixed(2)}</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-[11px] text-slate-400" style="font-family:'Fira Sans',sans-serif">
          Vagaro terms reported/verified 2026-06-22 (vagaro.com/pro/pricing): ~$30/mo (${vg.subscriptionPerYear.toFixed(0)}/yr,
          +$10/employee, cap ~$90) + ~2.6% + $0.10 processing; no new-client fee or commission. For a repeat client
          Vagaro's per-visit cash is higher because Good Circles passes ~10% to the customer; Good Circles' edge is
          bringing new clients at no acquisition fee, the total local value created, and no subscription. Illustration,
          not tax advice.
        </p>
      </div>
    </section>

    <SubscriptionCalculator defaultKey="vagaro" heading="Run your salon's numbers" />

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          A calendar isn't a customer
        </h2>
        <p class="text-slate-600 leading-relaxed mb-6" style="font-family:'Fira Sans',sans-serif">
          Vagaro does the booking-and-payments job well, and we're not going to pretend it's expensive — for your
          regulars it isn't. But software that organizes your existing clients is a different thing from a channel that
          brings you new ones, and that's the gap most local businesses actually need to close.
        </p>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          Good Circles fills that gap: new local clients come through nonprofits and their supporters at no acquisition
          fee or subscription, your customer saves ~10%, and a local cause is funded on every visit. Run Vagaro for your
          calendar if you like it — let Good Circles grow the book. See
          <a href="/sell/marketplace-fees-comparison/" class="font-bold underline" style="color:#7851A9">the full comparison &raquo;</a>
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Vagaro vs Good Circles — FAQ" />

    <CtaBand
      heading="Bring new local clients, not just manage old ones"
      text="Free to join. A 1% fee on profit only when you sell. The first 200 Mississippi businesses are Founding Merchants."
      label="Become a Founding Merchant (free) →"
      href="/#mirror-section"
      audience="MERCHANT"
      secondaryLabel="Compare every platform"
      secondaryHref="/sell/marketplace-fees-comparison/"
    />
  </main>
  <Footer />
</Base>
