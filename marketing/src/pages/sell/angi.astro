---
// /sell/angi — switch page for service pros on Angi (formerly Angie's List).
// Static (lead-gen model, not the [competitor] %-fee route). Verified 2026-06-22:
// Angi publishes no official price list; lead, membership, and ad costs and the
// annual-contract terms are reported figures, labeled as such throughout.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import FaqList from "../../components/FaqList.astro";
import CtaBand from "../../components/CtaBand.astro";
import LeadGenCalculator from "../../components/LeadGenCalculator.astro";
import { faqJsonLd, breadcrumbJsonLd, type Faq } from "../../lib/faq";
import { SITE_URL } from "../../data/site";
import { goodCircles, leadGen } from "../../data/sell-competitors";

const TITLE = "Angi Leads Alternative for Contractors (2026) · Good Circles";
const DESCRIPTION =
  "Angi sells shared leads on annual contracts, plus membership and ad fees - so winning a job can cost $200+ in lead fees. Good Circles takes a 1% fee on profit, with no lead fees, while customers save ~10%.";

const g = goodCircles(400, 150, 0.25); // $400 job, $150 cost to deliver, 25% tax
const an = leadGen(400, 150, 45, 20, 0.25); // $45/lead, 20% close → ~$225 to win a job

const FAQS: Faq[] = [
  {
    q: "How does Angi charge contractors?",
    a: "Angi's model combines shared leads with membership and advertising fees, often on annual contracts with early-termination penalties. There's no official public price list - reported per-lead costs run roughly $15 to $120, and because leads are shared and charged win or lose, your true cost to land a job is the lead price divided by your close rate.",
  },
  {
    q: "Will I keep more on Good Circles than on Angi?",
    a: "In most cases, yes. On a $400 job that costs $150 to deliver, winning one job at $45 per lead and a 1-in-5 close rate means about $225 in lead fees - leaving roughly $19 after tax. On Good Circles there are no lead fees and no annual contract: you keep about $140 after tax, your customer saves ~10%, and a local nonprofit is funded.",
  },
  {
    q: "Am I locked into a contract with Good Circles?",
    a: "No. Good Circles is free to join with a 1% fee on profit only when you complete a sale - no annual contract, no membership fee, no ads to buy, and no leads to bid on. Your customers come from local nonprofits and their supporters.",
  },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/sell/angi"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    breadcrumbJsonLd([
      { name: "Home", url: `${SITE_URL}/` },
      { name: "Sell", url: `${SITE_URL}/sell/` },
      { name: "Angi alternative", url: `${SITE_URL}/sell/angi/` },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: "Angi leads alternative for contractors (2026)",
      description: DESCRIPTION,
      datePublished: "2026-06-23",
      dateModified: "2026-06-23",
      author: { "@type": "Organization", name: "Good Circles" },
      publisher: { "@type": "Organization", name: "Good Circles", logo: { "@type": "ImageObject", url: `${SITE_URL}/og.png` } },
      mainEntityOfPage: `${SITE_URL}/sell/angi/`,
    },
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero
      eyebrow="Switch from Angi"
      badge="First 200 Mississippi businesses are Founding Merchants"
      h1="Angi sells shared leads on contracts. Good Circles takes 1% of profit."
    >
      <p slot="answer">
        Angi combines <strong>shared leads</strong> with membership and ad fees, often on <strong>annual contracts</strong>,
        and charges you <strong>whether or not you win the job</strong>. At a typical lead price and close rate, landing
        one job can cost <strong>$200+ in lead fees</strong>. Good Circles has <strong>no lead fees, no contract, and no
        merchant card cost</strong> — a <strong>1% fee on profit</strong>, your customer <strong>saves ~10%</strong>,
        and a local nonprofit gets funded. Free to join.
      </p>
      <Fragment slot="ctas">
        <a href="/#mirror-section" data-cta-audience="MERCHANT" class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider" style="background:#C2A76F;color:#241247">
          Become a Founding Merchant (free) →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">A $400 job, side by side</h2>
        <p class="text-slate-600 leading-relaxed mb-8" style="font-family:'Fira Sans',sans-serif">
          A $400 job that costs you $150 to deliver, at a 25% tax rate. On Angi, winning it at $45 per lead and a
          1-in-5 close rate means paying for <strong>{an.leadsPerWin} leads (~${an.winCost.toFixed(2)})</strong> — and
          you're charged for the {Math.round(an.leadsPerWin - 1)} you lost, on top of any membership or ad fees.
        </p>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm" style="border-collapse:collapse">
            <thead>
              <tr style="background:#faf7fd">
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Per job won</th>
                <th class="text-left p-3 font-black text-xs uppercase tracking-wider" style="color:#7851A9">Good Circles</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Angi</th>
              </tr>
            </thead>
            <tbody style="font-family:'Fira Sans',sans-serif">
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Customer pays</td>
                <td class="p-3 font-bold" style="color:#241247">${g.customerPays.toFixed(2)} (saves ${g.customerSaves.toFixed(2)})</td>
                <td class="p-3 text-slate-500">$400.00</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Cost to deliver</td>
                <td class="p-3 font-bold" style="color:#241247">($150.00)</td>
                <td class="p-3 text-slate-500">($150.00)</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Lead fees to win the job</td>
                <td class="p-3 font-bold" style="color:#241247">$0.00 (no lead cost)</td>
                <td class="p-3 text-slate-500">(${an.winCost.toFixed(2)})</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Platform fee</td>
                <td class="p-3 font-bold" style="color:#241247">(${g.platformFee.toFixed(2)}) — 1% of profit</td>
                <td class="p-3 text-slate-500">+ membership / ads (varies)</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Donation (deductible)</td>
                <td class="p-3 font-bold" style="color:#241247">(${g.donation.toFixed(2)})</td>
                <td class="p-3 text-slate-500">—</td>
              </tr>
              <tr style="border-top:2px solid #cbd5e1">
                <td class="p-3 font-black text-slate-900">Pre-tax profit</td>
                <td class="p-3 font-black" style="color:#241247">${g.preTaxProfit.toFixed(2)}</td>
                <td class="p-3 font-black text-slate-600">${an.preTaxProfit.toFixed(2)}</td>
              </tr>
              <tr style="background:#f7f3fc">
                <td class="p-3 font-black text-slate-900">After-tax profit (25%)</td>
                <td class="p-3 font-black" style="color:#241247">${g.afterTaxProfit.toFixed(2)}</td>
                <td class="p-3 font-black text-slate-600">${an.afterTaxProfit.toFixed(2)}</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 text-slate-500 text-xs">Customer saves / community funded</td>
                <td class="p-3 text-slate-500 text-xs">${g.customerSaves.toFixed(2)} / ${g.donation.toFixed(2)}</td>
                <td class="p-3 text-slate-500 text-xs">$0 / $0</td>
              </tr>
              <tr style="background:#f7f3fc">
                <td class="p-3 font-black text-slate-900">Total local value created</td>
                <td class="p-3 font-black" style="color:#241247">${g.totalLocalValue.toFixed(2)}</td>
                <td class="p-3 font-black text-slate-600">${an.totalLocalValue.toFixed(2)}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-[11px] text-slate-400" style="font-family:'Fira Sans',sans-serif">
          Angi publishes no official price list; lead costs, membership/ad fees, and annual-contract terms are reported
          figures and vary by trade and market (verified 2026-06-22) — set your own in the calculator. Leads are shared
          and charged win or lose. Good Circles takes a 1% fee on profit, with no lead fees, no contract, no ad spend,
          and no merchant card cost. Membership and ad fees would lower the Angi figures further. Illustration, not tax advice.
        </p>
      </div>
    </section>

    <LeadGenCalculator defaultKey="angi" heading="Run your trade's numbers" />

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Leads, ads, membership, and a contract
        </h2>
        <p class="text-slate-600 leading-relaxed mb-6" style="font-family:'Fira Sans',sans-serif">
          Angi doesn't just charge per lead — it layers in membership and advertising fees, often inside an annual
          contract with an early-termination penalty. You're paying to be listed, paying for shared leads you might
          lose, and committed for a year, all before you've earned a dollar.
        </p>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          Good Circles has none of that: no contract, no membership, no ads, no leads to buy. Your customers come from
          local nonprofits and their supporters, you keep about 89% of your profit, and every job funds a local cause.
          See <a href="/sell/marketplace-fees-comparison/" class="font-bold underline" style="color:#7851A9">the full marketplace comparison &raquo;</a>
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Angi vs Good Circles — FAQ" />

    <CtaBand
      heading="No leads to buy. No contract. No ads."
      text="Free to join. A 1% fee on profit only when you sell. The first 200 Mississippi businesses are Founding Merchants."
      label="Become a Founding Merchant (free) →"
      href="/#mirror-section"
      audience="MERCHANT"
      secondaryLabel="Compare every platform"
      secondaryHref="/sell/marketplace-fees-comparison/"
    />
  </main>
  <Footer />
</Base>
