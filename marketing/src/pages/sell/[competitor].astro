---
// Data-driven switch pages for the percentage-fee competitors. Content per
// competitor lives in src/data/sell-pages.ts; the verified fee + verdict come
// from src/data/sell-competitors.ts. DoorDash, Etsy, and Groupon are hand-built
// static files (not in SELL_PAGES), so there is no route collision.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import FaqList from "../../components/FaqList.astro";
import CtaBand from "../../components/CtaBand.astro";
import WhatYouKeepCalculator from "../../components/WhatYouKeepCalculator.astro";
import { faqJsonLd, breadcrumbJsonLd, type Faq } from "../../lib/faq";
import { SITE_URL } from "../../data/site";
import { goodCircles, competitor, round2, COMPETITORS } from "../../data/sell-competitors";
import { SELL_PAGES } from "../../data/sell-pages";

export function getStaticPaths() {
  return SELL_PAGES.map((p) => ({ params: { competitor: p.key }, props: { page: p } }));
}

const { page } = Astro.props;
const comp = COMPETITORS.find((c) => c.key === page.key)!;
const { price, cogs, mkt } = page.example;
const g = goodCircles(price, cogs, 0.25);
const c = competitor(price, cogs, comp.typicalFeePct, 0.25, mkt);
const valueGain = round2(g.totalLocalValue - c.totalLocalValue);
const gcWinsCash = g.afterTaxProfit >= c.afterTaxProfit;
const money = (n: number) => `$${n.toFixed(2)}`;
const FAQS: Faq[] = page.faqs;
---

<Base
  title={page.title}
  description={page.description}
  path={`/sell/${page.key}`}
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    breadcrumbJsonLd([
      { name: "Home", url: `${SITE_URL}/` },
      { name: "Sell", url: `${SITE_URL}/sell/` },
      { name: `${comp.name} alternative`, url: `${SITE_URL}/sell/${page.key}/` },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: page.h1,
      description: page.description,
      datePublished: "2026-06-23",
      dateModified: "2026-06-23",
      author: { "@type": "Organization", name: "Good Circles" },
      publisher: { "@type": "Organization", name: "Good Circles", logo: { "@type": "ImageObject", url: `${SITE_URL}/og.png` } },
      mainEntityOfPage: `${SITE_URL}/sell/${page.key}/`,
    },
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow={page.eyebrow} badge="First 200 Mississippi businesses are Founding Merchants" h1={page.h1}>
      <p slot="answer" set:html={page.answerHtml}></p>
      <Fragment slot="ctas">
        <a href="/#mirror-section" data-cta-audience="MERCHANT" class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider" style="background:#C2A76F;color:#241247">
          Become a Founding Merchant (free) →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          A {money(price)} sale, side by side
        </h2>
        <p class="text-slate-600 leading-relaxed mb-8" style="font-family:'Fira Sans',sans-serif">
          A {money(price)} sale that costs you {money(cogs)}, at a 25% tax rate. Full accounting, all the way to
          after-tax profit and the total local value of the sale.
        </p>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm" style="border-collapse:collapse">
            <thead>
              <tr style="background:#faf7fd">
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Per {money(price)} sale</th>
                <th class="text-left p-3 font-black text-xs uppercase tracking-wider" style="color:#7851A9">Good Circles</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">{comp.name}</th>
              </tr>
            </thead>
            <tbody style="font-family:'Fira Sans',sans-serif">
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Customer pays</td>
                <td class="p-3 font-bold" style="color:#241247">{money(g.customerPays)} (saves {money(g.customerSaves)})</td>
                <td class="p-3 text-slate-500">{page.compCustomerPays}</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Platform fee · ads · card</td>
                <td class="p-3 font-bold" style="color:#241247">{money(g.platformFee)} · $0 · $0</td>
                <td class="p-3 text-slate-500">{money(c.fee)} · {mkt > 0 ? money(c.marketing) : "$0"} · in fee</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 font-bold text-slate-900">Donation to a local nonprofit (deductible)</td>
                <td class="p-3 font-bold" style="color:#241247">{money(g.donation)}</td>
                <td class="p-3 text-slate-500">—</td>
              </tr>
              <tr style="border-top:2px solid #cbd5e1">
                <td class="p-3 font-black text-slate-900">Pre-tax profit</td>
                <td class="p-3 font-black" style="color:#241247">{money(g.preTaxProfit)}</td>
                <td class="p-3 font-black text-slate-600">{money(c.preTaxProfit)}</td>
              </tr>
              <tr style="background:#f7f3fc">
                <td class="p-3 font-black text-slate-900">After-tax profit (25%)</td>
                <td class="p-3 font-black" style="color:#241247">{money(g.afterTaxProfit)}</td>
                <td class="p-3 font-black text-slate-600">{money(c.afterTaxProfit)}</td>
              </tr>
              <tr style="border-bottom:1px solid #E7DCF2">
                <td class="p-3 text-slate-500 text-xs">Customer saves / community funded</td>
                <td class="p-3 text-slate-500 text-xs">{money(g.customerSaves)} / {money(g.donation)}</td>
                <td class="p-3 text-slate-500 text-xs">$0 / $0</td>
              </tr>
              <tr style="background:#f7f3fc">
                <td class="p-3 font-black text-slate-900">Total local value created</td>
                <td class="p-3 font-black" style="color:#241247">{money(g.totalLocalValue)}</td>
                <td class="p-3 font-black text-slate-600">{money(c.totalLocalValue)}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-slate-600 leading-relaxed mb-2" style="font-family:'Fira Sans',sans-serif">
          {gcWinsCash
            ? `On this example you keep more in your own pocket after tax on Good Circles (${money(g.afterTaxProfit)} vs ${money(c.afterTaxProfit)}) — and create about ${money(valueGain)} more in total local value, with your customer saving ${money(g.customerSaves)} and a local nonprofit funded.`
            : `On this example your after-tax cash is comparable (${money(g.afterTaxProfit)} on Good Circles vs ${money(c.afterTaxProfit)}), but Good Circles creates about ${money(valueGain)} more total local value — the equivalent margin goes to your customer and a local nonprofit instead of the platform, and it lowers your taxable income.`}
        </p>
        <p class="text-[11px] text-slate-400" style="font-family:'Fira Sans',sans-serif">
          {comp.name} terms verified 2026-06-22 ({comp.source}); {comp.detail} Good Circles takes a 1% fee on profit,
          with no ad spend and no merchant card cost (the customer pays credit card processing if they use a card).
          Illustration, not tax advice.
        </p>
      </div>
    </section>

    <WhatYouKeepCalculator defaultKey={page.key} heading="Run your own numbers" />

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">{page.intro.h2}</h2>
        <p class="text-slate-600 leading-relaxed mb-6" style="font-family:'Fira Sans',sans-serif">{page.intro.p1}</p>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif" set:html={page.intro.p2Html}></p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading={`${comp.name} vs Good Circles — FAQ`} />

    <CtaBand
      heading="Keep more of what you earn"
      text="Free to join. A 1% fee on profit only when you sell. The first 200 Mississippi businesses are Founding Merchants."
      label="Become a Founding Merchant (free) →"
      href="/#mirror-section"
      audience="MERCHANT"
      secondaryLabel="Compare every platform"
      secondaryHref="/sell/marketplace-fees-comparison"
    />
  </main>
  <Footer />
</Base>
