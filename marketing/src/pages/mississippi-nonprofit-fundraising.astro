---
// /mississippi-nonprofit-fundraising — single Q&A page answering the 40 questions
// small and Mississippi nonprofits ask about fundraising, plus a Good Circles
// section. Same structure as the other Q&A pages: jump nav, zero-JS accordions,
// one H1, FAQPage + Article + BreadcrumbList schema. Nonprofit-audience CTAs.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { faqJsonLd, breadcrumbJsonLd, type Faq } from "../lib/faq";
import { SITE_URL } from "../data/site";
import { MS_FUNDRAISING_QA } from "../data/mississippi-nonprofit-fundraising-qa";

const TITLE = "Nonprofit Fundraising in Mississippi: Questions and Answers · Good Circles";
const DESCRIPTION =
  "Practical answers to 40+ questions on nonprofit fundraising for small and Mississippi organizations: budgets, staffing, donors, channels, compliance, and free tools.";

const strip = (html: string) =>
  html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").replace(/\s+/g, " ").trim();

const allItems = MS_FUNDRAISING_QA.flatMap((c) => c.items);
const FAQS: Faq[] = allItems.map((i) => ({ q: i.q, a: strip(i.a) }));

const ARTICLE = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Nonprofit Fundraising in Mississippi: Questions and Answers",
  description: DESCRIPTION,
  datePublished: "2026-06-25",
  dateModified: "2026-06-25",
  author: { "@type": "Organization", name: "Good Circles" },
  publisher: { "@type": "Organization", name: "Good Circles", logo: { "@type": "ImageObject", url: `${SITE_URL}/og.png` } },
  mainEntityOfPage: `${SITE_URL}/mississippi-nonprofit-fundraising/`,
};
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/mississippi-nonprofit-fundraising"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    ARTICLE,
    breadcrumbJsonLd([
      { name: "Home", url: `${SITE_URL}/` },
      { name: "Nonprofit fundraising in Mississippi", url: `${SITE_URL}/mississippi-nonprofit-fundraising/` },
    ]),
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="Nonprofit fundraising" h1="Nonprofit fundraising in Mississippi: practical answers">
      <p slot="answer">
        Small nonprofits raise money with limited time, staff, and budget, which makes a few sound decisions worth
        more than a long list of tactics. The answers below are practical and honest, covering budgets, staffing,
        donors, channels, compliance, and the free tools that level the field. Most apply to any small organization,
        with Mississippi-specific notes where they matter. Good Circles adds one durable, low-effort stream to a
        healthy mix; it is not a replacement for grants or major gifts, and it works best for community-rooted
        organizations whose supporters shop locally.
      </p>
      <Fragment slot="ctas">
        <a
          href="/#mirror-section"
          data-cta-audience="NONPROFIT"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider"
          style="background:#C2A76F;color:#241247"
        >
          Claim your nonprofit's founding spot (free) →
        </a>
        <a
          href="/resources"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider text-white"
          style="border:1px solid rgba(255,255,255,0.35)"
        >
          Free nonprofit resources →
        </a>
      </Fragment>
    </PageHero>

    <nav class="py-8 px-6 bg-white" style="border-bottom:1px solid #eee" aria-label="Jump to a section">
      <div class="max-w-3xl mx-auto flex flex-wrap gap-2.5" style="font-family:'Fira Sans',sans-serif">
        {MS_FUNDRAISING_QA.map((cat) => (
          <a
            href={`#${cat.id}`}
            class="inline-block px-4 py-2 rounded-full text-sm font-bold transition-colors"
            style="background:#FBF7FE;border:1px solid #E7DCF2;color:#4B2E84;text-decoration:none"
          >
            {cat.title}
          </a>
        ))}
      </div>
    </nav>

    {MS_FUNDRAISING_QA.map((cat) => (
      <section id={cat.id} class="py-14 px-6 bg-white" style="border-bottom:1px solid #f1f1f1;scroll-margin-top:80px">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-black text-slate-900 mb-2" style="letter-spacing:-0.02em">{cat.title}</h2>
          <p class="text-slate-500 mb-8" style="font-family:'Fira Sans',sans-serif">{cat.blurb}</p>
          <div class="gc-faq flex flex-col gap-2">
            {cat.items.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <div class="gc-faq-a" set:html={item.a} />
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}

    <CtaBand
      heading="Add a recurring stream without a budget"
      text="Good Circles is free for nonprofits. Supporters fund your organization by shopping at participating local Mississippi businesses. The founding cohort is open now."
      label="Claim your nonprofit's founding spot (free) →"
      href="/#mirror-section"
      audience="NONPROFIT"
      secondaryLabel="Free nonprofit resources"
      secondaryHref="/resources"
    />

    <section class="py-12 px-6 bg-white">
      <div class="max-w-3xl mx-auto text-sm" style="font-family:'Fira Sans',sans-serif">
        <strong class="text-slate-900">Keep reading:</strong>
        <a href="/for-nonprofits" class="ml-3 underline" style="color:#7851A9">For nonprofits</a>
        <a href="/resources" class="ml-3 underline" style="color:#7851A9">Nonprofit resource hub</a>
        <a href="/resources/states/mississippi/" class="ml-3 underline" style="color:#7851A9">Mississippi playbook</a>
        <a href="/cause-marketing" class="ml-3 underline" style="color:#7851A9">Cause marketing Q&amp;A</a>
        <a href="/commercial-coventure" class="ml-3 underline" style="color:#7851A9">Commercial co-ventures</a>
        <p class="text-[11px] text-slate-400 mt-6 leading-relaxed">
          This page is general information to help nonprofit teams, not legal, tax, or financial advice. Benchmarks
          cited are common sector ranges, not guarantees, and your results will vary. Confirm compliance and tax
          questions with a qualified professional.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
