---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import { faqJsonLd, breadcrumbJsonLd } from '../../lib/faq';
import { SITE_URL } from '../../data/site';
import { ANSWERS, answerArticleJsonLd, type Answer } from '../../data/answers';

export function getStaticPaths() {
  return ANSWERS.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

interface Props {
  a: Answer;
}
const { a } = Astro.props;
const crumb = breadcrumbJsonLd([
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Answers', url: `${SITE_URL}/answers/` },
  { name: a.question, url: `${SITE_URL}/answers/${a.slug}/` },
]);
---

<Base
  title={a.title}
  description={a.description}
  path={`/answers/${a.slug}/`}
  ogType="article"
  jsonLd={[answerArticleJsonLd(a), faqJsonLd(a.faqs), crumb]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="Answers" h1={a.question}>
      <p slot="answer" set:html={a.lede} />
    </PageHero>

    <section class="py-14 px-6 bg-white">
      <div class="gc-learn max-w-3xl mx-auto" set:html={a.bodyHtml} />
    </section>

    <FaqList faqs={a.faqs} heading="Related questions" eyebrow="FAQ" />

    <section class="py-10 px-6 bg-white">
      <div class="max-w-3xl mx-auto text-sm" style="font-family:'Fira Sans',sans-serif">
        <strong class="text-slate-900">Related:</strong>
        {a.related.map((r) => (
          <a href={r.href} class="ml-3 underline" style="color:#7851A9">{r.label}</a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
