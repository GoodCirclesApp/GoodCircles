---
// Core explainer. Copy: GoodCircles_SEO_CorePages.md /how-it-works (verbatim).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqJsonLd, type Faq } from '../lib/faq';
import { SITE_URL } from '../data/site';

const TITLE = 'How Good Circles Works — Save ~10%, Give & Keep Money Local';
const DESCRIPTION =
  'One purchase, three wins: you save ~10%, a nonprofit you choose gets a share, and local businesses keep more. Here’s the simple math behind Good Circles.';

const FAQS: Faq[] = [
  {
    q: 'How does Good Circles work?',
    a: 'You shop local businesses through Good Circles, save about 10% automatically, and 10% of the merchant’s profit funds a nonprofit you chose at signup. The business keeps 89% of its profit. It’s free for shoppers and nonprofits.',
  },
  {
    q: 'Does Good Circles cost me anything?',
    a: 'No. It’s free for shoppers and nonprofits, and you actually save about 10%. Local businesses pay a 1% fee on profit.',
  },
  {
    q: 'How much does my nonprofit get?',
    a: '10% of the merchant’s profit on each purchase — a few dollars per sale, which adds up to thousands a year across a community.',
  },
  {
    q: 'Where is Good Circles available?',
    a: 'It launches in the Jackson, Mississippi metro in September 2026 and expands to the cities that request it most.',
  },
];

// HowTo schema mirrors the visible "Join in 3 minutes" steps.
const HOWTO_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to shop local and give back with Good Circles',
  description:
    'Join Good Circles in about 3 minutes: sign up free, pick your nonprofit, and shop local to save ~10% while a share of every sale funds your cause.',
  totalTime: 'PT3M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Sign up free',
      text: 'Sign up free at goodcircles.org — no app to download.',
      url: `${SITE_URL}/how-it-works/#join`,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Pick your nonprofit',
      text: 'Pick your nonprofit — any IRS-verified 501(c)(3). Change it anytime.',
      url: `${SITE_URL}/how-it-works/#join`,
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Shop local',
      text: 'Shop local. Prices already show about 10% lower, and a share of every sale funds your cause automatically.',
      url: `${SITE_URL}/how-it-works/#join`,
    },
  ],
};

// Worked example fixed by the accuracy contract: $100 item, $40 cost.
const MATH = [
  { label: 'You pay', amount: '$90', who: 'a 10% discount, automatic at checkout' },
  { label: 'Funds a nonprofit', amount: '$5', who: "10% of the merchant's profit ($50 profit after $40 cost)" },
  { label: 'Platform fee', amount: '$0.50', who: '1% of profit — how Good Circles runs' },
  { label: 'Merchant keeps', amount: '$84.50', who: '89% of profit + their costs' },
];
---

<Base title={TITLE} description={DESCRIPTION} path="/how-it-works" jsonLd={[faqJsonLd(FAQS), HOWTO_JSONLD]}>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="The model" h1="How Good Circles works">
      <p slot="answer">
        Good Circles is a community marketplace where one purchase does three things at once: you
        <strong>save about 10%</strong> on local shopping, <strong>10% of the business's profit
        funds a nonprofit you choose</strong>, and the business <strong>keeps 89% of its
        profit</strong> instead of losing 15–30% to a big platform. Same stores, same purchases —
        different math. Free to join.
      </p>
      <Fragment slot="ctas">
        <a
          href="/#mirror-section"
          data-cta-audience="NEIGHBOR"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider"
          style="background:#C2A76F;color:#241247"
        >
          Join free →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          One purchase, three wins
        </h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          Good Circles doesn't ask you to spend more, donate extra, or change where you shop. It
          changes the <em>rails</em> underneath the sale — where the money goes after you tap
          "pay."
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          The math on a $100 local purchase
        </h2>
        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm" style="border-collapse:collapse">
            <thead>
              <tr style="background:#faf7fd">
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider"></th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Amount</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Who</th>
              </tr>
            </thead>
            <tbody>
              {MATH.map((row) => (
                <tr style="border-bottom:1px solid #E7DCF2">
                  <td class="p-3 font-bold text-slate-900">{row.label}</td>
                  <td class="p-3 font-black" style="color:#7851A9">{row.amount}</td>
                  <td class="p-3 text-slate-500" style="font-family:'Fira Sans',sans-serif">{row.who}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="p-6 rounded-2xl mb-12" style="background:#fbf6ec;border-left:5px solid #C2A76F">
          <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
            The nonprofit's share comes from the <strong>merchant's profit</strong>, not your
            wallet — so it's a few dollars per sale. The power is in the aggregate: a town of 500
            regular shoppers sends roughly <strong>$36,000 a year</strong> to local causes, with
            zero extra spending.
          </p>
        </div>

        <h2 id="join" class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          Join in 3 minutes
        </h2>
        <ol class="mb-12 space-y-4" style="font-family:'Fira Sans',sans-serif">
          <li class="flex gap-4">
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-black text-white" style="background:#7851A9">1</span>
            <p class="text-slate-600 leading-relaxed"><strong>Sign up free</strong> at goodcircles.org — no app to download.</p>
          </li>
          <li class="flex gap-4">
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-black text-white" style="background:#7851A9">2</span>
            <p class="text-slate-600 leading-relaxed"><strong>Pick your nonprofit</strong> — any IRS-verified 501(c)(3). Change it anytime.</p>
          </li>
          <li class="flex gap-4">
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-black text-white" style="background:#7851A9">3</span>
            <p class="text-slate-600 leading-relaxed"><strong>Shop local.</strong> Prices already show ~10% lower, and a share of every sale funds your cause automatically. Your receipt shows exactly what you saved and gave.</p>
          </li>
        </ol>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          What you can buy
        </h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          Good Circles is a horizontal, <strong>local-first</strong> marketplace — groceries,
          prepared food, retail, repair and the trades, professional services, appointments, and
          more. When no local merchant carries something yet, you'll see an external "bridge"
          option (like Amazon) clearly labeled; those don't carry the 10% discount, and about half
          of that commission still funds nonprofits through a shared fund.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          The Founding Circle
        </h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          Good Circles launches in September 2026, starting in the Jackson, Mississippi metro and
          expanding from there. The first <strong>200 businesses</strong> become
          <a href="/for-business" class="font-bold underline" style="color:#7851A9">Founding Merchants</a>
          and the first <strong>50 nonprofits</strong> become
          <a href="/for-nonprofits" class="font-bold underline" style="color:#7851A9">Founding Nonprofits</a>
          — permanent recognition. Early shoppers are Founding Neighbors.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Why you can trust it
        </h2>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          Nonprofits are <strong>IRS-verified automatically</strong>, every receipt is itemized and
          transparent, and there's no extra cost to you — the model is funded by the small fee
          businesses pay, not your wallet.
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="How it works FAQ" />

    <CtaBand
      heading="One purchase. Three wins."
      text="Join free — launching September 2026, Jackson MS metro first."
      label="Join free →"
      href="/#mirror-section"
      audience="NEIGHBOR"
      secondaryLabel="The AmazonSmile alternative"
      secondaryHref="/amazonsmile-alternative"
    />

    <section class="py-10 px-6 bg-white">
      <div class="max-w-3xl mx-auto text-sm" style="font-family:'Fira Sans',sans-serif">
        <strong class="text-slate-900">Related:</strong>
        <a href="/shoppers" class="ml-3 underline" style="color:#7851A9">For shoppers</a>
        <a href="/for-nonprofits" class="ml-3 underline" style="color:#7851A9">For nonprofits</a>
        <a href="/for-business" class="ml-3 underline" style="color:#7851A9">For business</a>
        <a href="/amazonsmile-alternative" class="ml-3 underline" style="color:#7851A9">AmazonSmile alternative</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
