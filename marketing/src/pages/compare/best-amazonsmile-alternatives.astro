---
// Comparison page. Copy: GoodCircles_SEO_CorePages.md (verbatim).
// Competitor terms re-verified 2026-06-12 against igive.com (1,700+ stores,
// rates vary ~0.5–20%, commonly 1–3%) and shopraise.com (free, % of purchases
// at national retailers). Keep this page evenhanded; re-verify on updates.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { faqJsonLd, breadcrumbJsonLd, type Faq } from '../../lib/faq';
import { SITE_URL } from '../../data/site';

// Title/meta per the CTR-optimization spec (SEO Sprint 2026-07-05).
const TITLE = 'Best AmazonSmile Alternatives in 2026: 5 Options Compared';
const DESCRIPTION =
  'AmazonSmile ended in 2023. Compare 5 replacements side by side — Good Circles, ShopRaise, iGive, Goodshop & Bookshop.org — with a full table. Updated 2026.';

const FAQS: Faq[] = [
  {
    q: 'What replaced AmazonSmile?',
    a: 'Nothing official from Amazon. Independent options filled the gap: Good Circles (local-first, with savings), ShopRaise and iGive (a percentage of major-retailer purchases), Goodshop (coupons plus donations), and Bookshop.org (for books).',
  },
  {
    q: 'What is the best AmazonSmile alternative?',
    a: 'It depends what you want. Good Circles is the only one where you shop local, save about 10%, and fund a nonprofit you choose. ShopRaise and iGive are strong for donations on national-retailer purchases.',
  },
  {
    q: 'Do any AmazonSmile alternatives save me money?',
    a: 'Good Circles does — about 10% on local purchases. Most others donate a percentage of your purchase without lowering your price; Goodshop adds coupons.',
  },
];

const ARTICLE_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'The best AmazonSmile alternatives in 2026, compared',
  description: DESCRIPTION,
  datePublished: '2026-06-12',
  dateModified: '2026-06-12',
  author: { '@type': 'Organization', name: 'Good Circles' },
  publisher: {
    '@type': 'Organization',
    name: 'Good Circles',
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/og.png` },
  },
  mainEntityOfPage: `${SITE_URL}/compare/best-amazonsmile-alternatives/`,
};

const GLANCE = [
  { name: 'Good Circles ⭐', shop: 'Local businesses', save: 'Yes, ~10%', funded: 'A nonprofit you choose', how: "10% of the merchant's profit", cost: 'Free (shoppers/nonprofits)', highlight: true },
  { name: 'ShopRaise', shop: 'Major national retailers', save: 'No', funded: 'A nonprofit you choose', how: '% of eligible purchases*', cost: 'Free', highlight: false },
  { name: 'iGive', shop: '1,700+ online stores', save: 'No', funded: 'A nonprofit you choose', how: '% of eligible purchases*', cost: 'Free', highlight: false },
  { name: 'Goodshop', shop: 'Major retailers (+coupons)', save: 'Via coupons', funded: 'A cause you choose', how: 'Share of commission*', cost: 'Free', highlight: false },
  { name: 'Bookshop.org', shop: 'Books (online)', save: 'No', funded: 'Independent bookstores', how: 'Share of book sales', cost: 'Free', highlight: false },
  { name: 'AmazonSmile (ended 2023)', shop: 'Amazon only', save: 'No', funded: 'A charity you set', how: '0.5% of price', cost: '—', highlight: false },
];

const OPTIONS = [
  {
    name: 'Good Circles',
    body: 'The only local-first option, and the only one where you save money (about 10%) while giving. Best if you want to support local businesses and a local cause, and keep dollars in your community. Local-first; launching in Mississippi in 2026 and expanding by request.',
  },
  {
    name: 'ShopRaise',
    body: 'A well-built, nonprofit-friendly platform and app: shop major retailers and a percentage goes to your chosen organization. Best if your nonprofit wants a turnkey "shopping fundraiser" across big national stores.',
  },
  {
    name: 'iGive',
    body: 'One of the longest-running options; a browser tool that donates a percentage of purchases at a very large list of online stores. Best for broad online retailer coverage.',
  },
  {
    name: 'Goodshop',
    body: 'Pairs coupons and cash-back with donations at major retailers. Best if you want everyday coupon savings with a giving component.',
  },
  {
    name: 'Bookshop.org',
    body: 'Not a charity-shopping tool but a kindred spirit: an ethical online bookstore that channels profits to independent bookstores. Best if you mainly want to buy books without Amazon.',
  },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/compare/best-amazonsmile-alternatives"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    ARTICLE_JSONLD,
    breadcrumbJsonLd([
      { name: 'Home', url: `${SITE_URL}/` },
      { name: 'Compare', url: `${SITE_URL}/compare/best-amazonsmile-alternatives/` },
      { name: 'Best AmazonSmile alternatives', url: `${SITE_URL}/compare/best-amazonsmile-alternatives/` },
    ]),
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="Updated June 2026" h1="The best AmazonSmile alternatives in 2026, compared">
      <p slot="answer">
        The best AmazonSmile alternative in 2026 depends on how you shop:
        <strong>Good Circles</strong> is the only local-first option where you
        <strong>save about 10%</strong> while funding a nonprofit you choose;
        <strong>ShopRaise</strong> and <strong>iGive</strong> donate a percentage of
        national-retailer purchases; <strong>Goodshop</strong> adds coupons;
        <strong>Bookshop.org</strong> covers books. The table below compares all five side by
        side.
      </p>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          At a glance
        </h2>
        <div class="overflow-x-auto mb-3">
          <table class="w-full text-sm" style="border-collapse:collapse">
            <thead>
              <tr style="background:#faf7fd">
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Option</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Where you shop</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">You save?</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Who's funded</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">How it's funded</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">Cost</th>
              </tr>
            </thead>
            <tbody style="font-family:'Fira Sans',sans-serif">
              {GLANCE.map((row) => (
                <tr style={`border-bottom:1px solid #E7DCF2;${row.highlight ? 'background:#FBF7FE' : ''}`}>
                  <td class="p-3 font-black" style={row.highlight ? 'color:#7851A9' : 'color:#0f172a'}>{row.name}</td>
                  <td class="p-3 text-slate-600">{row.shop}</td>
                  <td class="p-3 text-slate-600">{row.save}</td>
                  <td class="p-3 text-slate-600">{row.funded}</td>
                  <td class="p-3 text-slate-600">{row.how}</td>
                  <td class="p-3 text-slate-600">{row.cost}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-slate-400 mb-12" style="font-family:'Fira Sans',sans-serif">
          * Donation rates vary by retailer and change over time — confirm current terms on each
          provider's site.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          The options, briefly (and fairly)
        </h2>
        <div class="space-y-6 mb-12">
          {OPTIONS.map((opt) => (
            <div>
              <p class="font-black text-slate-900 mb-1">{opt.name}</p>
              <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">{opt.body}</p>
            </div>
          ))}
        </div>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Why Good Circles is different
        </h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          Every other option asks you to <strong>give a slice</strong> of a purchase at a national
          retailer. Good Circles is the only one that puts you <strong>ahead</strong> — you pay
          about 10% less — while keeping the money <strong>local</strong> and funding a cause you
          choose. It's "save <em>and</em> give," not just "give." See
          <a href="/how-it-works/" class="font-bold underline" style="color:#7851A9">how the math works »</a>
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          How to choose
        </h2>
        <ul class="space-y-3 mb-4" style="font-family:'Fira Sans',sans-serif">
          <li class="text-slate-600 leading-relaxed">Want to <strong>save money and support your own community</strong>? → <strong>Good Circles.</strong></li>
          <li class="text-slate-600 leading-relaxed">Run a <strong>nonprofit</strong> wanting a national-retailer shopping fundraiser? → ShopRaise (and add Good Circles for local).</li>
          <li class="text-slate-600 leading-relaxed">Mostly buy <strong>books</strong>? → Bookshop.org.</li>
          <li class="text-slate-600 leading-relaxed">Want <strong>coupons + a little giving</strong>? → Goodshop.</li>
        </ul>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="AmazonSmile alternatives FAQ" />

    <CtaBand
      heading="Try Good Circles — free"
      text="The only option where you shop local, save about 10%, and fund a nonprofit you choose."
      label="Try Good Circles — free →"
      href="/#mirror-section"
      audience="NEIGHBOR"
      secondaryLabel="The AmazonSmile alternative"
      secondaryHref="/amazonsmile-alternative/"
    />

    <section class="py-10 px-6 bg-white">
      <div class="max-w-4xl mx-auto text-sm" style="font-family:'Fira Sans',sans-serif">
        <strong class="text-slate-900">Head-to-head:</strong>
        <a href="/compare/vs-shopraise/" class="ml-3 underline" style="color:#7851A9">vs ShopRaise</a>
        <a href="/compare/vs-goodshop/" class="ml-3 underline" style="color:#7851A9">vs Goodshop</a>
        <a href="/compare/vs-igive/" class="ml-3 underline" style="color:#7851A9">vs iGive</a>
        <a href="/compare/vs-bookshop/" class="ml-3 underline" style="color:#7851A9">vs Bookshop.org</a>
        <br /><br />
        <strong class="text-slate-900">Related:</strong>
        <a href="/amazonsmile-alternative/" class="ml-3 underline" style="color:#7851A9">AmazonSmile alternative</a>
        <a href="/how-it-works/" class="ml-3 underline" style="color:#7851A9">How it works</a>
        <a href="/for-nonprofits/" class="ml-3 underline" style="color:#7851A9">For nonprofits</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
