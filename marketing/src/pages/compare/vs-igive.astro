---
// iGive terms verified 2026-06-12 (igive.com): free; donates a % of purchases
// at 1,700+ online stores; rates vary by retailer (~0.5%–20%, commonly 1–3%);
// typical member raises ~$100/yr. Kept fair; re-verify on updates.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { faqJsonLd, breadcrumbJsonLd, type Faq } from '../../lib/faq';
import { SITE_URL } from '../../data/site';

const TITLE = 'Good Circles vs iGive — Compared (2026)';
const DESCRIPTION =
  'Good Circles vs iGive: both fund nonprofits when you shop, but only Good Circles is local-first and saves you ~10%. An even-handed 2026 comparison.';

const FAQS: Faq[] = [
  {
    q: 'What is the difference between Good Circles and iGive?',
    a: 'iGive donates a percentage of your purchases at 1,700+ online stores to a nonprofit you choose. Good Circles is local-first: you shop local businesses, save about 10%, and 10% of the merchant’s profit funds your chosen nonprofit.',
  },
  {
    q: 'Does iGive or Good Circles save me money?',
    a: 'iGive donates a percentage of your purchase without lowering your price. Good Circles lowers your price by about 10% on local purchases and still funds a nonprofit — so you come out ahead.',
  },
  {
    q: 'Are both free to use?',
    a: 'Yes. iGive is free, and Good Circles is free for shoppers and nonprofits — Good Circles is funded by a 1% fee local businesses pay on profit.',
  },
];

const ROWS = [
  { label: 'Where you shop', gc: 'Local businesses near you', other: '1,700+ online stores' },
  { label: 'You save money', gc: 'Yes, ~10% on local purchases', other: 'No — price is unchanged' },
  { label: 'Who gets funded', gc: 'A nonprofit you choose', other: 'A nonprofit you choose' },
  { label: 'How it’s funded', gc: "10% of the merchant's profit", other: '% of eligible purchases (varies)' },
  { label: 'Local focus', gc: 'Local-first', other: 'National online retailers' },
  { label: 'Cost', gc: 'Free (shoppers & nonprofits)', other: 'Free' },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/compare/vs-igive"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    breadcrumbJsonLd([
      { name: 'Home', url: `${SITE_URL}/` },
      { name: 'Compare', url: `${SITE_URL}/compare/best-amazonsmile-alternatives/` },
      { name: 'Good Circles vs iGive', url: `${SITE_URL}/compare/vs-igive/` },
    ]),
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="Comparison · Updated June 2026" h1="Good Circles vs iGive, compared">
      <p slot="answer">
        Both Good Circles and iGive let you fund a nonprofit when you shop — differently.
        <strong>iGive</strong> is one of the longest-running options, donating a percentage of your
        purchases at 1,700+ online stores. <strong>Good Circles</strong> is local-first: you shop
        local businesses, <strong>save about 10%</strong>, and 10% of the merchant's profit funds a
        nonprofit you choose. Here's an even-handed look.
      </p>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="overflow-x-auto mb-10">
          <table class="w-full text-sm" style="border-collapse:collapse">
            <thead>
              <tr style="background:#faf7fd">
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider"></th>
                <th class="text-left p-3 font-black text-xs uppercase tracking-wider" style="color:#7851A9">Good Circles</th>
                <th class="text-left p-3 font-black text-slate-500 text-xs uppercase tracking-wider">iGive</th>
              </tr>
            </thead>
            <tbody style="font-family:'Fira Sans',sans-serif">
              {ROWS.map((row) => (
                <tr style="border-bottom:1px solid #E7DCF2">
                  <td class="p-3 font-bold text-slate-900">{row.label}</td>
                  <td class="p-3 font-bold" style="color:#241247">{row.gc}</td>
                  <td class="p-3 text-slate-500">{row.other}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">Where iGive shines</h2>
        <p class="text-slate-600 leading-relaxed mb-10" style="font-family:'Fira Sans',sans-serif">
          iGive has been around since the early days of charity shopping and offers broad coverage —
          a percentage of your purchases at a very large list of online stores goes to your cause,
          with a browser tool to make it automatic. If your priority is wide national online
          retailer coverage, it's a proven choice.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">Where Good Circles is different</h2>
        <p class="text-slate-600 leading-relaxed mb-10" style="font-family:'Fira Sans',sans-serif">
          iGive sends a slice of a national-retailer purchase to your cause. Good Circles lowers
          your price by about 10% on <em>local</em> purchases <em>and</em> funds your cause
          <em>and</em> keeps the money in your community. It's "save and give," not just "give." See
          the <a href="/compare/best-amazonsmile-alternatives/" class="font-bold underline" style="color:#7851A9">full field of AmazonSmile alternatives »</a>
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Good Circles vs iGive FAQ" />

    <CtaBand
      heading="Shop local, save, and give"
      text="The only option that lowers your price while funding a local cause."
      label="Try Good Circles — free →"
      href="/#mirror-section"
      audience="NEIGHBOR"
      secondaryLabel="Compare all alternatives"
      secondaryHref="/compare/best-amazonsmile-alternatives/"
    />
  </main>
  <Footer />
</Base>
