---
// National demand-capture hub. Copy: GoodCircles_SEO_CityPages.md §7 + the
// request-your-city.html mockup. The mockup's "most-requested cities" tiles
// used ILLUSTRATIVE counts — omitted here per the accuracy contract; the live
// leaderboard ships once real request counts are wired from the directory.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FaqList from '../components/FaqList.astro';
import { faqJsonLd, type Faq } from '../lib/faq';
import RequestCityForm from '../components/react/RequestCityForm';

const TITLE = 'Bring Good Circles to Your City — Local Shopping That Gives Back';
const DESCRIPTION =
  'Want to shop local, save ~10%, and fund a nonprofit you love in your city? Add your name. The cities with the most requests launch first.';

const FAQS: Faq[] = [
  {
    q: 'How do I bring Good Circles to my city?',
    a: 'Add your name and city on this page. We launch in the cities with the most requests first, and requesters get early founding access when their city goes live.',
  },
  {
    q: 'When will Good Circles launch in my city?',
    a: 'Good Circles launches in Mississippi in 2026 and expands to the most-requested cities next. The more neighbors who request your city, the sooner it happens.',
  },
  {
    q: 'Is it free to request?',
    a: 'Yes. Requesting is free, and there’s never a cost for shoppers or nonprofits to join.',
  },
];
---

<Base title={TITLE} description={DESCRIPTION} path="/request-your-city/" jsonLd={[faqJsonLd(FAQS)]}>
  <Nav solid />
  <main id="main">
    <header class="px-6 pt-12 pb-16" style="background:linear-gradient(150deg,#241247 0%,#4B2E84 58%,#7851A9 100%)">
      <div class="max-w-3xl mx-auto">
        <p
          class="inline-block px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-widest text-white mb-6"
          style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.25)"
        >
          National · Coming to the cities that want it most
        </p>
        <h1 class="font-black text-white mb-6" style="font-size:clamp(2rem,5.5vw,3.2rem);letter-spacing:-0.02em;line-height:1.05">
          Bring Good Circles to your city
        </h1>
        <div
          class="text-white/90 text-lg leading-relaxed rounded-2xl p-6"
          style="background:rgba(255,255,255,0.09);border:1px solid rgba(255,255,255,0.18);font-family:'Fira Sans',sans-serif"
        >
          Good Circles is launching in Mississippi first, then expanding to the cities that want it
          most. <strong>Add your name and your city</strong> — when enough neighbors request it,
          your city moves up the list, and you'll be first in when we launch. It's free, and it's
          the fastest way to bring local shopping that gives back to where you live.
        </div>
      </div>
    </header>

    <section class="py-14 px-6 bg-white">
      <div class="max-w-2xl mx-auto">
        <div class="p-8 rounded-3xl" style="background:#fff;box-shadow:0 4px 40px rgba(120,81,169,0.12)">
          <h2 class="text-2xl font-black text-slate-900 mb-2">Request your city</h2>
          <p class="text-slate-500 mb-6" style="font-family:'Fira Sans',sans-serif">
            Takes 20 seconds. Every request is a vote for where Good Circles launches next.
          </p>
          <RequestCityForm client:load />
        </div>
      </div>
    </section>

    <section class="py-14 px-6" style="background:#FBF7FE">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-black uppercase tracking-widest mb-2" style="color:#C2A76F">How it works</p>
        <h2 class="text-3xl font-black text-slate-900 mb-8" style="letter-spacing:-0.02em">Three steps</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="p-6 rounded-2xl bg-white" style="border:1px solid #E7DCF2">
            <p class="text-3xl font-black mb-1" style="color:#7851A9">1</p>
            <p class="font-black text-slate-900 mb-1">Request your city</p>
            <p class="text-sm text-slate-500" style="font-family:'Fira Sans',sans-serif">Add your email and city — takes 20 seconds.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white" style="border:1px solid #E7DCF2">
            <p class="text-3xl font-black mb-1" style="color:#C2A76F">2</p>
            <p class="font-black text-slate-900 mb-1">Spread the word</p>
            <p class="text-sm text-slate-500" style="font-family:'Fira Sans',sans-serif">The more neighbors who request, the sooner it launches.</p>
          </div>
          <div class="p-6 rounded-2xl bg-white" style="border:1px solid #E7DCF2">
            <p class="text-3xl font-black mb-1" style="color:#241247">3</p>
            <p class="font-black text-slate-900 mb-1">Be first in</p>
            <p class="text-sm text-slate-500" style="font-family:'Fira Sans',sans-serif">Requesters get early founding access when Good Circles arrives.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-black uppercase tracking-widest mb-2" style="color:#C2A76F">Why we do it this way</p>
        <h2 class="text-3xl font-black text-slate-900 mb-4" style="letter-spacing:-0.02em">We build where we're wanted</h2>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          Good Circles is local-first, so we launch a city only when there's a real community ready
          for it. Requesting tells us where that community already exists — so we build where we're
          wanted, and you get a marketplace that actually has local businesses and causes on day
          one. The most-requested cities will be published right here as requests come in.
        </p>
        <p class="mt-4 text-sm" style="font-family:'Fira Sans',sans-serif">
          Already in Mississippi?
          <a href="/shop-local/mississippi/" class="font-bold underline" style="color:#7851A9">Find your city »</a>
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} />
  </main>
  <Footer />
</Base>
