---
// Business pillar. Copy: GoodCircles_SEO_PageCopy.md PAGE 4 (verbatim).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqJsonLd, type Faq } from '../lib/faq';

const TITLE = 'Sell Local, Keep 89% — The Low-Fee Marketplace That Gives Back';
const DESCRIPTION =
  'A 1% fee on profit instead of 15–30%. Customers save and fund a cause when they buy from you. Become a Founding Merchant free.';

const FAQS: Faq[] = [
  {
    q: 'How much does Good Circles cost a business?',
    a: 'Just 1% of profit per sale — there are no setup, monthly, or listing fees. If you don’t sell, you don’t pay.',
  },
  {
    q: 'How is this cheaper than DoorDash or Amazon?',
    a: 'Those platforms take 15–30% of each sale. Good Circles charges 1% of profit, so you keep about 89% of your profit — often more than a dollar more per item.',
  },
  {
    q: 'Do I have to handle sales tax?',
    a: 'No. Good Circles acts as the marketplace facilitator and collects and remits sales tax on your Good Circles sales for you.',
  },
];

const HOW = [
  {
    title: 'Keep 89% of your profit',
    body: 'A 1% fee on profit, not 15–30% of the sale.',
  },
  {
    title: 'A built-in tax advantage',
    body: 'The 10% that funds a nonprofit is a tax-deductible charitable contribution, and Good Circles collects and remits sales tax for you as the marketplace facilitator.',
  },
  {
    title: 'Customers choose you',
    body: 'Shoppers save ~10% and fund their cause when they buy local, so they have a reason to pick you over the chain.',
  },
];
---

<Base title={TITLE} description={DESCRIPTION} path="/for-business" jsonLd={[faqJsonLd(FAQS)]}>
  <Nav solid />
  <main id="main">
    <PageHero
      eyebrow="For local business"
      badge="First 200 Mississippi businesses become Founding Merchants"
      h1="Keep 89% of your profit. Fund your community."
    >
      <p slot="answer">
        Good Circles is a local marketplace built for your margins. You pay a <strong>1% fee on
        profit</strong> instead of the 15–30% the big apps take — keeping <strong>89% of your
        profit</strong> — while customers <strong>save ~10%</strong> and fund a local nonprofit
        when they buy from you. It's free to join, with no sale meaning no cost.
      </p>
      <Fragment slot="ctas">
        <a
          href="/#mirror-section"
          data-cta-audience="MERCHANT"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider"
          style="background:#C2A76F;color:#241247"
        >
          Become a Founding Merchant (free) →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          The problem isn't sales — it's the fees
        </h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          Delivery apps and national platforms take 15–30% of every order. That's not margin
          you're giving up; that's payroll and rent. The model is built to extract from local
          businesses, not support them.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">
          How Good Circles works for you
        </h2>
        <div class="grid sm:grid-cols-3 gap-4 mb-12">
          {HOW.map((item) => (
            <div class="p-6 rounded-2xl" style="background:#FBF7FE;border:1px solid #E7DCF2">
              <p class="font-black text-slate-900 mb-2">{item.title}</p>
              <p class="text-sm text-slate-500 leading-relaxed" style="font-family:'Fira Sans',sans-serif">{item.body}</p>
            </div>
          ))}
        </div>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          The math
        </h2>
        <div class="p-8 rounded-3xl mb-12" style="background:#FBF7FE;border:1px solid #E7DCF2">
          <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
            On a $10 item you can net about <strong>$1.34 more per sale</strong> than on a delivery
            app — roughly <strong>$1,600 a year</strong> at 100 sales a month. Same product.
            Different rails. See the worked example on
            <a href="/how-it-works" class="font-bold underline" style="color:#7851A9">how it works »</a>
          </p>
        </div>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Be a Founding Merchant
        </h2>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          The <strong>first 200 Mississippi businesses</strong> become Founding Merchants —
          permanent badge and homepage placement. $0 to register, $0 monthly, no sale means no
          cost.
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Business FAQ" />

    <CtaBand
      heading="Become a Founding Merchant"
      text="$0 to register, $0 monthly. A 1% fee on profit only when you sell."
      label="Become a Founding Merchant (free) →"
      href="/#mirror-section"
      audience="MERCHANT"
      secondaryLabel="How it works"
      secondaryHref="/how-it-works"
    />

    <section class="py-12 px-6 bg-white">
      <div class="max-w-3xl mx-auto text-sm" style="font-family:'Fira Sans',sans-serif">
        <a href="/for-business/for-restaurants" class="block p-4 rounded-xl no-underline mb-6" style="background:#FBF7FE;border:1px solid #E7DCF2">
          <p class="font-black text-slate-900">Run a restaurant? Ditch the 30% delivery fee ›</p>
        </a>
        <strong class="text-slate-900">Related:</strong>
        <a href="/amazonsmile-alternative" class="ml-3 underline" style="color:#7851A9">AmazonSmile alternative</a>
        <a href="/how-it-works" class="ml-3 underline" style="color:#7851A9">How it works</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
