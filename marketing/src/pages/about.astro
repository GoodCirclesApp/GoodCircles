---
// About page — E-E-A-T + GEO entity anchor (clear, named operator + mission +
// model). Founder confirmed: Timothy Franklin. No fabricated biographical or
// legal-entity specifics.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqJsonLd, type Faq } from '../lib/faq';

const TITLE = 'About Good Circles — Our Mission to Keep Money Local';
const DESCRIPTION =
  'Good Circles is an independent community marketplace where shopping local saves you ~10% and funds a nonprofit you choose. Meet the mission and the model.';

const FAQS: Faq[] = [
  {
    q: 'Who is behind Good Circles?',
    a: 'Good Circles is an independent company founded in 2026 by Timothy Franklin, based in Mississippi. It isn’t backed by big-box retail or a venture firm with conflicting interests — it’s built to keep money and benefit inside local communities.',
  },
  {
    q: 'What does Good Circles do?',
    a: 'It’s a community marketplace: you shop local businesses, save about 10%, and 10% of the merchant’s profit funds a nonprofit you choose. Merchants keep 89% of their profit on a 1% fee, instead of losing 15–30% to big platforms.',
  },
  {
    q: 'When and where does Good Circles launch?',
    a: 'Good Circles launches in September 2026 in the Jackson, Mississippi metro, then expands node-by-node across Mississippi and to the cities that request it most.',
  },
];
---

<Base title={TITLE} description={DESCRIPTION} path="/about" jsonLd={[faqJsonLd(FAQS)]}>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="About" h1="We're rebuilding local commerce so everyone wins">
      <p slot="answer">
        Good Circles is an independent community marketplace, founded in 2026 by Timothy Franklin
        and based in Mississippi. The idea is simple: <strong>shopping local should save you
        money, fund a cause you care about, and keep dollars in your community</strong> — all at
        once. We launch in the Jackson metro in September 2026.
      </p>
      <Fragment slot="ctas">
        <a
          href="/#mirror-section"
          data-cta-audience="NEIGHBOR"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider"
          style="background:#C2A76F;color:#241247"
        >
          Join the founding circle →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">Why we exist</h2>
        <p class="text-slate-600 leading-relaxed mb-6" style="font-family:'Fira Sans',sans-serif">
          Most of every dollar spent at a national chain or a big app leaves your community the
          moment you tap "pay." Local businesses lose 15–30% of each sale to platforms built to
          extract from them. And in 2023, when Amazon shut down AmazonSmile, millions of shoppers
          and nonprofits lost the easiest way they had to give back. We thought the answer should
          be local, and it should leave everyone better off.
        </p>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          So Good Circles changes the rails underneath the sale. You shop the local businesses you
          already love, the price is about 10% lower, the merchant keeps far more of their profit,
          and a share of every sale funds a nonprofit you chose — automatically, at no extra cost
          to you.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">The model, in one line</h2>
        <div class="p-6 rounded-2xl mb-12" style="background:#FBF7FE;border:1px solid #E7DCF2">
          <p class="text-slate-700 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
            On a local purchase, <strong>you save ~10%</strong>, <strong>10% of the merchant's
            profit</strong> funds the nonprofit you picked, the platform takes a <strong>1%</strong>
            fee on profit, and the <strong>merchant keeps 89% of their profit</strong>. See the
            full math on <a href="/how-it-works" class="font-bold underline" style="color:#7851A9">how it works »</a>
          </p>
        </div>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">Who we serve</h2>
        <p class="text-slate-600 leading-relaxed mb-12" style="font-family:'Fira Sans',sans-serif">
          Good Circles is built for three sides of every transaction:
          <a href="/shoppers" class="font-bold underline" style="color:#7851A9">neighbors</a> who
          want to save and give without changing how they shop,
          <a href="/for-business" class="font-bold underline" style="color:#7851A9">local businesses</a>
          tired of losing margin to big platforms, and
          <a href="/for-nonprofits" class="font-bold underline" style="color:#7851A9">nonprofits</a>
          that need recurring funding without one more grant or gala.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">Where we're going</h2>
        <p class="text-slate-600 leading-relaxed" style="font-family:'Fira Sans',sans-serif">
          We launch in Mississippi first, in September 2026, because local-first means launching a
          city only when there's a real community ready for it. From there we grow node-by-node and
          by request — the cities that ask for Good Circles most are the ones we build next. You
          can <a href="/request-your-city" class="font-bold underline" style="color:#7851A9">put your city on the map »</a>
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="About Good Circles" />

    <CtaBand
      heading="Be part of the founding circle"
      text="Free for shoppers and nonprofits, launching September 2026 in the Jackson, MS metro."
      label="Join free →"
      href="/#mirror-section"
      audience="NEIGHBOR"
      secondaryLabel="How it works"
      secondaryHref="/how-it-works"
    />
  </main>
  <Footer />
</Base>
