---
// /cause-marketing — a single, comprehensive Q&A page answering the 40 questions
// business owners ask about cause marketing, plus a Good Circles section. Zero-JS
// accordions (reuses the gc-faq styling), a jump-to nav, one H1, and FAQPage +
// Article + BreadcrumbList schema. Answers render with set:html so internal links
// work; the FAQPage answer text is the tag-stripped version.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { faqJsonLd, breadcrumbJsonLd, type Faq } from "../lib/faq";
import { SITE_URL } from "../data/site";
import { CAUSE_MARKETING_QA } from "../data/cause-marketing-qa";

const TITLE = "Cause Marketing: Questions Business Owners Actually Ask · Good Circles";
const DESCRIPTION =
  "Straight, practical answers to 40+ real questions about cause marketing: what works, what to avoid, how to choose a cause, and how to build giving into every sale.";

const strip = (html: string) =>
  html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").replace(/\s+/g, " ").trim();

const allItems = CAUSE_MARKETING_QA.flatMap((c) => c.items);
const FAQS: Faq[] = allItems.map((i) => ({ q: i.q, a: strip(i.a) }));

const ARTICLE = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Cause Marketing: Questions Business Owners Actually Ask",
  description: DESCRIPTION,
  datePublished: "2026-06-25",
  dateModified: "2026-06-25",
  author: { "@type": "Organization", name: "Good Circles" },
  publisher: { "@type": "Organization", name: "Good Circles", logo: { "@type": "ImageObject", url: `${SITE_URL}/og.png` } },
  mainEntityOfPage: `${SITE_URL}/cause-marketing/`,
};
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/cause-marketing"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    ARTICLE,
    breadcrumbJsonLd([
      { name: "Home", url: `${SITE_URL}/` },
      { name: "Cause marketing", url: `${SITE_URL}/cause-marketing/` },
    ]),
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="Cause marketing" h1="Cause marketing: the questions business owners actually ask">
      <p slot="answer">
        Cause marketing ties what a business sells to support for a cause, so that buying becomes a way to give.
        Done well, it builds trust, loyalty, and differentiation. Done poorly, it reads as a gimmick. The answers
        below are practical and honest, including where this approach does not fit. Good Circles is not the right
        tool for every business, but for the large majority that are local and consumer-facing, building giving into
        every sale is more durable and more affordable than any campaign.
      </p>
      <Fragment slot="ctas">
        <a
          href="/#mirror-section"
          data-cta-audience="MERCHANT"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider"
          style="background:#C2A76F;color:#241247"
        >
          Become a Founding Merchant (free) →
        </a>
        <a
          href="/sell/marketplace-fees-comparison/"
          class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider text-white"
          style="border:1px solid rgba(255,255,255,0.35)"
        >
          Compare the economics →
        </a>
      </Fragment>
    </PageHero>

    <!-- Jump-to navigation -->
    <nav class="py-8 px-6 bg-white" style="border-bottom:1px solid #eee" aria-label="Jump to a section">
      <div class="max-w-3xl mx-auto flex flex-wrap gap-2.5" style="font-family:'Fira Sans',sans-serif">
        {CAUSE_MARKETING_QA.map((cat) => (
          <a
            href={`#${cat.id}`}
            class="inline-block px-4 py-2 rounded-full text-sm font-bold transition-colors"
            style="background:#FBF7FE;border:1px solid #E7DCF2;color:#4B2E84;text-decoration:none"
          >
            {cat.title}
          </a>
        ))}
      </div>
    </nav>

    {CAUSE_MARKETING_QA.map((cat) => (
      <section id={cat.id} class="py-14 px-6 bg-white" style="border-bottom:1px solid #f1f1f1;scroll-margin-top:80px">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-black text-slate-900 mb-2" style="letter-spacing:-0.02em">{cat.title}</h2>
          <p class="text-slate-500 mb-8" style="font-family:'Fira Sans',sans-serif">{cat.blurb}</p>
          <div class="gc-faq flex flex-col gap-2">
            {cat.items.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <div class="gc-faq-a" set:html={item.a} />
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}

    <CtaBand
      heading="Build the cause into every sale"
      text="Free to join. A 1% fee on profit, customers save about 10%, and 10% of your profit funds a local nonprofit your customer chooses."
      label="Become a Founding Merchant (free) →"
      href="/#mirror-section"
      audience="MERCHANT"
      secondaryLabel="Compare every marketplace"
      secondaryHref="/sell/marketplace-fees-comparison/"
    />

    <section class="py-12 px-6 bg-white">
      <div class="max-w-3xl mx-auto text-sm" style="font-family:'Fira Sans',sans-serif">
        <strong class="text-slate-900">Keep reading:</strong>
        <a href="/sell/" class="ml-3 underline" style="color:#7851A9">Sell on Good Circles</a>
        <a href="/commercial-coventure/" class="ml-3 underline" style="color:#7851A9">Commercial co-ventures</a>
        <a href="/for-business/" class="ml-3 underline" style="color:#7851A9">For business</a>
        <a href="/for-nonprofits/" class="ml-3 underline" style="color:#7851A9">For nonprofits</a>
        <a href="/how-it-works/" class="ml-3 underline" style="color:#7851A9">How it works</a>
        <a href="/resources/" class="ml-3 underline" style="color:#7851A9">Nonprofit resources</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
