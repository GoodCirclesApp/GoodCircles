---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { faqJsonLd, type Faq } from '../../lib/faq';

const TITLE = 'Ditch the 30% Delivery Fee — Sell Local · Good Circles';
const DESCRIPTION =
  'Keep more of every order than on the delivery apps, and turn customers into community funders. The low-fee local marketplace for restaurants. Join free.';

const FAQS: Faq[] = [
  {
    q: 'How much does Good Circles cost a restaurant?',
    a: 'Just 1% of profit per sale — no setup, monthly, or listing fees, and no per-order commission. If you don’t sell, you don’t pay. Compare that to the 15–30% delivery apps take from each order.',
  },
  {
    q: 'How is this different from DoorDash or Uber Eats?',
    a: 'Delivery apps take 15–30% of each order. Good Circles charges 1% of profit, so you keep about 89% of your profit. Customers also save about 10% and fund a local nonprofit when they order from you.',
  },
  {
    q: 'Do I have to handle sales tax?',
    a: 'No. Good Circles acts as the marketplace facilitator and collects and remits sales tax on your Good Circles orders for you.',
  },
];
---

<Base title={TITLE} description={DESCRIPTION} path="/for-business/for-restaurants" jsonLd={[faqJsonLd(FAQS)]}>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="For restaurants" badge="First 200 Mississippi businesses are Founding Merchants" h1="Keep your margins. Ditch the 30% delivery fee.">
      <p slot="answer">
        Good Circles is a local marketplace built for restaurant margins. Instead of the 15–30% the
        delivery apps take per order, you pay a <strong>1% fee on profit</strong> — keeping
        <strong>89% of your profit</strong> — while customers <strong>save ~10%</strong> and fund a
        local nonprofit when they order from you. It's free to join, with no sale meaning no cost.
      </p>
      <Fragment slot="ctas">
        <a href="/#mirror-section" data-cta-audience="MERCHANT" class="inline-block px-8 py-4 rounded-full font-black text-sm uppercase tracking-wider" style="background:#C2A76F;color:#241247">
          Become a Founding Merchant (free) →
        </a>
      </Fragment>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">The delivery apps are eating your margin</h2>
        <p class="text-slate-600 leading-relaxed mb-6" style="font-family:'Fira Sans',sans-serif">
          A 30% commission on a thin-margin restaurant order isn't a marketing cost — it's the
          difference between a profitable ticket and a loss. The delivery platforms are built to
          extract from local kitchens, not support them. Good Circles is the opposite: a 1% fee on
          profit, so the value of each order stays with the people who cooked it.
        </p>
        <p class="text-slate-600 leading-relaxed mb-10" style="font-family:'Fira Sans',sans-serif">
          And your customers have a reason to choose you: they save about 10% and fund a local
          cause when they order through Good Circles. Same food, different rails. See the full
          picture for businesses on <a href="/for-business" class="font-bold underline" style="color:#7851A9">Good Circles for business »</a>
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Restaurant FAQ" />

    <CtaBand
      heading="Keep what you earn"
      text="$0 to register, $0 monthly, a 1% fee on profit only when you sell."
      label="Become a Founding Merchant (free) →"
      href="/#mirror-section"
      audience="MERCHANT"
      secondaryLabel="For business"
      secondaryHref="/for-business"
    />
  </main>
  <Footer />
</Base>
