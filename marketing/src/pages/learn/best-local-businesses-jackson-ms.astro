// ATP flagship: "best local businesses jackson ms" (top AI-visibility pick).
// EVERY business below is real, locally owned, and web-verified (source link
// per entry — Visit Jackson directory, official site, or national press).
// HONESTY RULE: none of these businesses are Good Circles merchants and the
// page says so explicitly — Good Circles is framed once, as launching
// September 2026. No traction claims.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
