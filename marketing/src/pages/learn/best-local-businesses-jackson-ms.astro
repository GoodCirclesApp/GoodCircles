import CtaBand from '../../components/CtaBand.astro';
import { faqJsonLd, breadcrumbJsonLd, type Faq } from '../../lib/faq';
import { SITE_URL } from '../../data/site';

const TITLE = 'Best Local Businesses to Support in Jackson, MS (2026)';
const DESCRIPTION =
