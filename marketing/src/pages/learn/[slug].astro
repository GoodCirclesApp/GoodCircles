---
// Answer/PAA pages, driven by src/data/learn.ts (generated from the canonical
// SEO&GEO/learn mockups). Article + FAQPage JSON-LD come straight from the
// deliverables; article body renders verbatim inside the .gc-learn scope.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ALL_LEARN, type LearnArticle } from '../../data/learn-all';
import { breadcrumbJsonLd } from '../../lib/faq';
import { SITE_URL } from '../../data/site';
import { AFFILIATE_DISCLOSURE } from '../../lib/affiliates';

export function getStaticPaths() {
  return ALL_LEARN.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: LearnArticle;
}
const { article } = Astro.props;
const crumb = breadcrumbJsonLd([
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'Learn', url: `${SITE_URL}/learn/` },
  { name: article.h1, url: `${SITE_URL}/learn/${article.slug}/` },
]);

// Flagship guides are bylined to founder Timothy Franklin (SEO Sprint
// 2026-07-05, Task 5b) — visible byline + Person author in the Article
// JSON-LD, both linking to /about/timothy-franklin/.
const AUTHOR_URL = '/about/timothy-franklin/';
const FLAGSHIP_SLUGS = new Set([
  'what-happened-to-amazonsmile',
  'best-amazonsmile-alternatives-for-nonprofits',
  'what-is-passive-fundraising',
  'how-small-nonprofits-raise-money-without-grants',
  'what-is-a-community-marketplace',
  'why-shopping-local-matters',
  'start-a-local-business',
]);
const bylined = FLAGSHIP_SLUGS.has(article.slug);
const articleLd = bylined
  ? {
      ...(article.articleJsonLd as Record<string, unknown>),
      author: {
        '@type': 'Person',
        name: 'Timothy Franklin',
        url: `${SITE_URL}${AUTHOR_URL}`,
      },
    }
  : article.articleJsonLd;
---

<Base
  title={article.title}
  description={article.description}
  path={`/learn/${article.slug}/`}
  ogType="article"
  jsonLd={[articleLd, article.faqJsonLd, crumb]}
>
  <Nav solid />
  <main id="main" style="background:#FBF7FE">
    <div class="max-w-3xl mx-auto px-6 py-10">
      <nav class="text-sm mb-4" style="color:#6B6577;font-family:'Montserrat',sans-serif;font-weight:600" aria-label="Breadcrumb">
        <a href="/learn/" class="no-underline" style="color:#8A6A2E">Learn</a>
        <span> › </span>
        <span>{article.h1}</span>
      </nav>
      <h1 class="font-black mb-2" style="color:#2E1B4E;font-size:clamp(1.9rem,4vw,2.7rem);letter-spacing:-1px;line-height:1.15">
        {article.h1}
      </h1>
      <p class="text-sm mb-6" style="color:#6B6577;font-family:'Montserrat',sans-serif;font-weight:600">
        {article.dateline}
        {bylined && (
          <>
            {' · By '}
            <a href={AUTHOR_URL} class="underline" style="color:#8A6A2E">Timothy Franklin</a>
            {', founder of Good Circles'}
          </>
        )}
      </p>
      <article class="gc-learn pb-4" set:html={article.articleHtml} />
      {article.articleHtml.includes('data-affiliate') && (
        <p class="text-xs text-slate-400 pb-10" style="font-family:'Fira Sans',sans-serif">{AFFILIATE_DISCLOSURE}</p>
      )}
    </div>
  </main>
  <Footer />
</Base>
