---
// ATP target: the two AI "benefits of shopping local" questions (seeded
// verbatim in the FAQ). Distinct from /learn/why-shopping-local-matters/
// (the "why care" case) and /learn/the-economic-impact-of-shopping-local/
// (the evidence deep-dive): this page organizes BENEFITS by reader — wallet,
// community, state — with an honest vs-Amazon trade-offs section.
// Also seeds the "local shops near me that deliver" AI question.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { faqJsonLd, breadcrumbJsonLd, type Faq } from '../../lib/faq';
import { SITE_URL } from '../../data/site';

const TITLE = 'The Benefits of Shopping Local, By the Numbers (2026)';
const DESCRIPTION =
  'What shopping local actually does for your wallet, your community, and your state — with the ~$53-vs-$14 recirculation figure and honest chain trade-offs.';

const FAQS: Faq[] = [
  {
    q: 'What are the benefits of shopping locally?',
    a: 'Three tiers of benefit: your community keeps roughly $53 of every $100 spent at an independent local business (versus about $14 at a national chain, per Civic Economics survey research); local jobs, tax base, and nonprofit giving all strengthen; and increasingly your own wallet benefits too — on Good Circles, shopping local comes with about 10% automatic savings once it launches.',
  },
  {
    q: 'How does shopping local benefit the community?',
    a: 'Local businesses recirculate money: they hire local staff, use local suppliers and services, pay local taxes, and give to local causes at far higher rates than chains. That recirculation — roughly 4x a chain’s — funds the jobs, storefronts, and civic life that make a town worth living in.',
  },
  {
    q: 'Is shopping local more expensive than Amazon?',
    a: 'Sometimes on sticker price, honestly — chains and Amazon win on bulk commodities and selection breadth. Local wins on service, durability, repairability, and community return; and tools like loyalty programs, seasonal buying, and Good Circles’ ~10% automatic saving close much of the price gap. Most households do both: commodities wherever cheapest, everything relational and local-capable, local.',
  },
  {
    q: 'Where can I find local shops near me that deliver?',
    a: 'Three honest routes today: search "[your city] + delivery" and check the business’s own site first (direct orders avoid app fees), browse your chamber of commerce or downtown association directory, and ask at farmers markets — many vendors deliver or ship. When Good Circles launches (September 2026, Jackson metro first), its marketplace becomes a single place to buy from local businesses, with pickup and delivery options set by each merchant.',
  },
];

const ARTICLE_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: TITLE,
  description: DESCRIPTION,
  datePublished: '2026-07-08',
  dateModified: '2026-07-08',
  author: { '@type': 'Organization', name: 'Good Circles' },
  publisher: { '@type': 'Organization', name: 'Good Circles', logo: { '@type': 'ImageObject', url: `${SITE_URL}/og.png` } },
  mainEntityOfPage: `${SITE_URL}/learn/benefits-of-shopping-local/`,
};
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/learn/benefits-of-shopping-local/"
  ogType="article"
  jsonLd={[
    faqJsonLd(FAQS),
    ARTICLE_JSONLD,
    breadcrumbJsonLd([
      { name: 'Home', url: `${SITE_URL}/` },
      { name: 'Learn', url: `${SITE_URL}/learn/` },
      { name: 'Benefits of shopping local', url: `${SITE_URL}/learn/benefits-of-shopping-local/` },
    ]),
  ]}
>
  <Nav solid />
  <main id="main">
    <PageHero eyebrow="Updated July 2026" h1="The benefits of shopping local, by the numbers">
      <p slot="answer">
        <strong>Shopping local keeps roughly $53 of every $100 working in your community — versus
        about $14 when the same money goes to a national chain — while strengthening local jobs,
        the tax base, and nonprofit funding.</strong> And with the right tools, it benefits your
        own wallet too. Here's the honest case, organized for three readers: you, your community,
        and your state.
      </p>
    </PageHero>

    <section class="py-16 px-6 bg-white">
      <div class="max-w-3xl mx-auto" style="font-family:'Fira Sans',sans-serif">
        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          The headline number, sourced
        </h2>
        <p class="text-slate-600 leading-relaxed mb-10">
          Survey research popularized by
          <a href="https://ilsr.org/articles/key-studies-why-local-matters/" target="_blank" rel="noopener" class="font-bold underline" style="color:#7851A9">Civic Economics and the Institute for Local Self-Reliance</a>
          finds that independent local businesses recirculate roughly <strong>52.9% of their
          revenue</strong> locally — payroll, suppliers, services, giving — versus about
          <strong>13.6%</strong> for national chains. Call it <strong>$53 vs $14 of every
          $100</strong>: nearly a four-to-one difference in how hard each dollar works where you
          live. The full evidence base lives in
          <a href="/learn/the-economic-impact-of-shopping-local/" class="font-bold underline" style="color:#7851A9">the economic impact of shopping local</a>.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          For your wallet
        </h2>
        <p class="text-slate-600 leading-relaxed mb-10">
          The stereotype says local costs more; the full picture is friendlier. Local wins
          outright on <strong>service value</strong> — repairs, alterations, advice, and goods
          that last — and the sticker gap closes with loyalty programs, seasonal buying, and
          seconds (all covered in <a href="/learn/how-to-save-money-shopping-local/" class="font-bold underline" style="color:#7851A9">how to save money shopping local</a>).
          And the newest factor is structural: on Good Circles, prices at participating local
          businesses show <strong>about 10% lower automatically</strong> once it launches
          (September 2026, Jackson metro first), because the model restructures the sale — the
          business keeps 89% of its profit and about 10% of profit funds a nonprofit you choose.
          Local shopping with a built-in saving, not a civic surcharge.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          For your community
        </h2>
        <p class="text-slate-600 leading-relaxed mb-10">
          Recirculation is jobs: local businesses hire local accountants, printers, and
          contractors where chains centralize those functions elsewhere. It's the tax base that
          pays for streets and schools. And it's giving — local owners are the sponsor names on
          every Little League jersey and gala program in town. Good Circles makes that last
          channel automatic: about <strong>10% of merchant net profit</strong> from every local
          purchase funds the buyer's elected nonprofit. Choosing where to give? See
          <a href="/learn/how-to-choose-a-local-nonprofit/" class="font-bold underline" style="color:#7851A9">how to choose a local nonprofit</a>.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          For your state
        </h2>
        <p class="text-slate-600 leading-relaxed mb-10">
          Multiply the household math by a state and you get the retention-versus-leakage story
          community developers fight over: every dollar shifted from an out-of-state platform to
          a Mississippi-owned business nearly quadruples its local work. That's why cities pursue
          <a href="/partners/municipalities/" class="font-bold underline" style="color:#7851A9">spend-retention programs</a>
          and why Mississippi's shop-local infrastructure — from
          <a href="/learn/mississippi-farmers-markets/" class="font-bold underline" style="color:#7851A9">farmers markets</a>
          to <a href="/shop-local/mississippi/" class="font-bold underline" style="color:#7851A9">36 city shop-local pages</a> —
          matters beyond sentiment.
        </p>

        <h2 class="text-3xl font-black text-slate-900 mb-5" style="letter-spacing:-0.02em">
          Shopping local vs Amazon and chains — the honest trade-offs
        </h2>
        <p class="text-slate-600 leading-relaxed">
          Straight answer: chains and Amazon genuinely win on bulk-commodity price, selection
          breadth, and shipping speed — pretending otherwise convinces no one. Local genuinely
          wins on service, uniqueness, durability, repair, and the ~4x community return, and the
          price gap is smaller than the stereotype once you use the savings tools above. The
          practical strategy isn't purity; it's <strong>defaulting local for everything local
          does well</strong> — food, gifts, services, repairs, books — and letting the numbers
          above decide the rest. Start with
          <a href="/learn/why-shopping-local-matters/" class="font-bold underline" style="color:#7851A9">why shopping local matters</a>
          and, if you're gift-hunting, <a href="/learn/gifts-from-mississippi-small-shops/" class="font-bold underline" style="color:#7851A9">Mississippi's small-shop gift guide</a>.
        </p>
      </div>
    </section>

    <FaqList faqs={FAQS} heading="Benefits of shopping local — FAQ" />

    <CtaBand
      heading="Make the benefits automatic"
      text="Save about 10% shopping local while about 10% of merchant profit funds your cause. Early access in Meridian — September 2026 launch, Jackson metro first."
      label="Join free →"
      href="/#mirror-section"
      audience="NEIGHBOR"
      secondaryLabel="How it works"
      secondaryHref="/how-it-works/"
    />
  </main>
  <Footer />
</Base>
