---
// Learn hub. Copy/design: SEO&GEO/learn/index.html (canonical).
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ALL_LEARN } from '../../data/learn-all';

// Title/meta per the CTR-optimization spec (SEO Sprint 2026-07-05).
const TITLE = 'AmazonSmile Alternatives & Shop-Local Guides | Good Circles';
const DESCRIPTION =
  '35+ free guides on shopping local, passive fundraising, and AmazonSmile alternatives — for shoppers, nonprofits, and local businesses. Updated 2026.';
---

<Base title={TITLE} description={DESCRIPTION} path="/learn/" ogType="article">
  <Nav solid />
  <main id="main" style="background:#FBF7FE">
    <div class="max-w-4xl mx-auto px-6 py-10">
      <nav class="text-sm mb-4" style="color:#6B6577;font-family:'Montserrat',sans-serif;font-weight:600" aria-label="Breadcrumb">
        <a href="/" class="no-underline" style="color:#8A6A2E">Good Circles</a>
        <span> › </span>
        <span>Learn</span>
      </nav>
      <h1 class="font-black mb-2" style="color:#2E1B4E;font-size:clamp(1.9rem,4vw,2.7rem);letter-spacing:-1px;line-height:1.15">
        Learn: shop local, give back, raise more
      </h1>
      <p class="text-base mb-8 leading-relaxed" style="color:#4a4360;font-family:'Fira Sans',sans-serif;max-width:46rem">
        This is the Good Circles learning hub: free, plain-English guides on shopping local,
        passive fundraising, and the best AmazonSmile alternatives since the program ended in
        2023. Guides are organized for three readers — shoppers who want to save and give,
        nonprofits that need recurring funding, and local businesses selling online.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 pb-12">
        {[
          { slug: 'best-local-businesses-jackson-ms', cardTitle: 'Best Local Businesses to Support in Jackson, MS (2026)', blurb: 'A verified, source-cited guide to locally-owned Jackson favorites — Fondren diners, Lemuria Books, Bully’s, and more…' },
          { slug: 'passive-nonprofit-funding', cardTitle: 'Passive Nonprofit Funding: Every Honest Option', blurb: 'Roundups, employer matching, shopping portals, search giving, and local-first profit-share — compared honestly…' },
          { slug: 'how-to-save-money-shopping-local', cardTitle: 'How to Save Money Shopping Local: 7 Real Tactics', blurb: 'Loyalty programs, seconds, seasonal buying, co-ops, market timing, repair-over-replace, and automatic savings…' },
          { slug: 'what-big-platforms-cost-local-businesses', cardTitle: 'What Big Platforms Really Cost Local Businesses', blurb: 'Fees come off the sale but are paid out of profit — the decoded math behind 15–30% marketplace fees…' },
          { slug: 'how-to-choose-a-local-nonprofit', cardTitle: 'How to Choose a Local Nonprofit to Support', blurb: 'A four-step chooser framework with free verification tools — IRS status, 990s, and matching support to need…' },
          { slug: 'passive-fundraising-ideas', cardTitle: '15 Passive Fundraising Ideas, Ranked by Effort', blurb: 'Every real passive option graded honestly — what it is, realistic yield, and the organizations it fits…' },
          { slug: 'passive-fundraising-for-schools', cardTitle: 'Passive Fundraising for Schools, PTAs & Boosters', blurb: 'Why product sales burn out volunteers, the truly-passive alternatives, and an honest worked example…' },
          { slug: 'benefits-of-shopping-local', cardTitle: 'The Benefits of Shopping Local, By the Numbers', blurb: 'The ~$53-vs-$14 recirculation case organized for your wallet, your community, and your state…' },
          { slug: 'mississippi-farmers-markets', cardTitle: 'Mississippi Farmers Markets: A Verified Guide', blurb: 'Region-by-region verified market directory — Jackson, Meridian, the Coast, and North Mississippi…' },
          { slug: 'gifts-from-mississippi-small-shops', cardTitle: 'Unique Gifts from Mississippi Small Shops & Artisans', blurb: 'Delta pottery, Jackson pralines, letterpress art, and the South’s legendary independent bookstores…' },
          { slug: 'what-replaced-amazonsmile', cardTitle: 'What Replaced AmazonSmile?', blurb: 'AmazonSmile ended in Feb 2023 — the shop-and-give options that filled the gap, and the local-first successor that also saves you ~10%…' },
          { slug: 'apps-that-donate-to-charity-when-you-shop', cardTitle: 'Apps That Donate to Charity When You Shop', blurb: 'ShopRaise, Givebacks, iGive, RaiseRight — plus a local-first option where you also save about 10% while you give…' },
          { slug: 'support-a-nonprofit-without-spending-extra', cardTitle: 'How to Support a Nonprofit Without Spending Extra', blurb: 'Fund a cause through spending you already do — portals, gift cards, and local-first giving that puts money back in your pocket…' },
        ].map((g) => (
          <a
            href={`/learn/${g.slug}/`}
            class="block p-5 rounded-2xl bg-white transition-shadow hover:shadow-lg no-underline"
            style="border:1px solid #E7DCF2"
          >
            <h2 class="font-black mb-2" style="color:#2E1B4E;font-size:1.05rem;font-family:'Montserrat',sans-serif;line-height:1.3">
              {g.cardTitle}
            </h2>
            <p class="text-sm" style="color:#4a4360;font-family:'Fira Sans',sans-serif">{g.blurb}</p>
          </a>
        ))}
        {ALL_LEARN.map((article) => (
          <a
            href={`/learn/${article.slug}/`}
            class="block p-5 rounded-2xl bg-white transition-shadow hover:shadow-lg no-underline"
            style="border:1px solid #E7DCF2"
          >
            <h2 class="font-black mb-2" style="color:#2E1B4E;font-size:1.05rem;font-family:'Montserrat',sans-serif;line-height:1.3">
              {article.cardTitle}
            </h2>
            <p class="text-sm" style="color:#4a4360;font-family:'Fira Sans',sans-serif" set:html={article.blurb} />
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Base>
