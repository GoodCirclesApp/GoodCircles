---
// County hub pages (DORMANT — see docs/seo/county-expansion-plan.md).
// getStaticPaths emits nothing while COUNTY_ENGINE_ENABLED is false, so this
// route adds ZERO pages to the live build. Pages also ship noindex until a
// county is deliberately seeded (isCountyIndexable), so indexing is wave-gated.
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import FaqList from '../../../../components/FaqList.astro';
import StartBusinessCta from '../../../../components/StartBusinessCta.astro';
import RequestCityForm from '../../../../components/react/RequestCityForm';
import { faqJsonLd, breadcrumbJsonLd, type Faq } from '../../../../lib/faq';
import { SITE_URL, partnerMentionJsonLd } from '../../../../data/site';
import { COUNTIES, COUNTY_ENGINE_ENABLED, isCountyIndexable, townSlug, type County } from '../../../../data/counties';
import { CITIES } from '../../../../data/cities';

export function getStaticPaths() {
  if (!COUNTY_ENGINE_ENABLED) return []; // dormant → no pages generated
  return COUNTIES.map((county) => ({
    params: { state: county.stateSlug, county: county.slug },
    props: { county },
  }));
}

interface Props {
  county: County;
}
const { county } = Astro.props;
const path = `/shop-local/${county.stateSlug}/county/${county.slug}/`;
const indexable = isCountyIndexable(county);

// Link a town to its city page only if one actually exists (gate-safe — never a broken link).
const msCitySlugs = new Set(CITIES.map((c) => c.slug));
const towns = county.towns.map((name) => {
  const slug = townSlug(name);
  const href =
    county.stateSlug === 'mississippi' && msCitySlugs.has(slug)
      ? `/shop-local/mississippi/${slug}/`
      : null;
  return { name, href };
});

const TITLE = `Shop Local in ${county.name}, ${county.st} — Support Local Businesses & Give Back`;
const DESCRIPTION = `Shop local across ${county.name}, ${county.st}, save ~10%, and fund a local nonprofit you choose. Good Circles is coming to the ${county.name} area — add your name to be first in.`;

const FAQS: Faq[] = [
  {
    q: `Is Good Circles available in ${county.name}, ${county.st}?`,
    a: `Not yet — Good Circles launches in Mississippi first, in 2026, then expands to the areas that request it most. Add your name to move the ${county.name} area up the list and get early founding access.`,
  },
  {
    q: `Which towns does ${county.name} cover?`,
    a: `${county.name}'s county seat is ${county.seat}, and it includes ${county.towns.slice(0, 6).join(', ')}${county.towns.length > 6 ? ', and more' : ''}.`,
  },
  {
    q: 'Is it free to request my area?',
    a: 'Yes. Requesting is free, and there’s never a cost for shoppers or nonprofits to join Good Circles.',
  },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path={path}
  noindex={!indexable}
  jsonLd={[
    faqJsonLd(FAQS),
    partnerMentionJsonLd(`${SITE_URL}${path}`),
    breadcrumbJsonLd([
      { name: 'Shop Local', url: `${SITE_URL}/shop-local/` },
      { name: county.state, url: `${SITE_URL}/shop-local/${county.stateSlug}/` },
      { name: county.name, url: `${SITE_URL}${path}` },
    ]),
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Towns in ${county.name}, ${county.st}`,
      itemListElement: towns.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name })),
    },
  ]}
>
  <Nav solid />
  <main id="main">
    <header class="px-6 pt-12 pb-16" style="background:linear-gradient(150deg,#241247 0%,#4B2E84 58%,#7851A9 100%)">
      <div class="max-w-3xl mx-auto">
        <nav class="text-sm mb-6" style="color:#cdb9ee;font-family:'Fira Sans',sans-serif" aria-label="Breadcrumb">
          <a href="/shop-local/" class="underline hover:text-white" style="color:#cdb9ee">Shop Local</a>
          <span> › </span>
          <a href={`/shop-local/${county.stateSlug}/`} class="underline hover:text-white" style="color:#cdb9ee">{county.state}</a>
          <span> › </span>
          <span class="text-white">{county.name}</span>
        </nav>
        <p class="inline-block px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-widest text-white mb-6" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.25)">
          {county.name}, {county.st} · Coming soon — by request
        </p>
        <h1 class="font-black text-white mb-6" style="font-size:clamp(2rem,5.5vw,3.2rem);letter-spacing:-0.02em;line-height:1.05">
          Shop local across {county.name} — and fund a local nonprofit
        </h1>
        <div class="text-white/90 text-lg leading-relaxed rounded-2xl p-6" style="background:rgba(255,255,255,0.09);border:1px solid rgba(255,255,255,0.18);font-family:'Fira Sans',sans-serif">
          Good Circles is a local-first way to shop {county.name} businesses, <strong>save about
          10%</strong>, and fund a local nonprofit you choose — at no extra cost. We're not live in
          the {county.name} area yet. <strong>Add your name and you'll be first in when we launch.</strong>
        </div>
      </div>
    </header>

    <section class="py-14 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-slate-600 leading-relaxed mb-8" style="font-family:'Fira Sans',sans-serif">
          {county.name} ({county.region}) is anchored by its county seat, <strong>{county.seat}</strong>.
          Most of every dollar spent at a national chain leaves the area the moment it's spent — Good
          Circles changes the rails so it stays local, and gives back, right across the county.
        </p>
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="p-6 rounded-2xl text-center" style="background:#FBF7FE;border:1px solid #E7DCF2">
            <p class="text-3xl font-black mb-1" style="color:#7851A9">~10%</p><p class="font-black text-slate-900 mb-1">You save</p><p class="text-sm text-slate-500" style="font-family:'Fira Sans',sans-serif">Automatic at checkout on local purchases.</p>
          </div>
          <div class="p-6 rounded-2xl text-center" style="background:#FBF7FE;border:1px solid #E7DCF2">
            <p class="text-3xl font-black mb-1" style="color:#C2A76F">10%</p><p class="font-black text-slate-900 mb-1">Funds your cause</p><p class="text-sm text-slate-500" style="font-family:'Fira Sans',sans-serif">10% of the business's profit funds a local nonprofit you choose.</p>
          </div>
          <div class="p-6 rounded-2xl text-center" style="background:#FBF7FE;border:1px solid #E7DCF2">
            <p class="text-3xl font-black mb-1" style="color:#241247">89%</p><p class="font-black text-slate-900 mb-1">Stays local</p><p class="text-sm text-slate-500" style="font-family:'Fira Sans',sans-serif">Local businesses keep 89% of their profit.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 px-6" style="background:#FBF7FE">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-black uppercase tracking-widest mb-2" style="color:#C2A76F">Towns &amp; cities</p>
        <h2 class="text-2xl font-black text-slate-900 mb-6" style="letter-spacing:-0.02em">Communities across {county.name}</h2>
        <div class="flex flex-wrap gap-3" style="font-family:'Fira Sans',sans-serif">
          {towns.map((t) => (
            t.href ? (
              <a href={t.href} class="px-4 py-2 rounded-full text-sm font-bold" style="background:#fff;border:1px solid #E7DCF2;color:#52407e">{t.name} ›</a>
            ) : (
              <span class="px-4 py-2 rounded-full text-sm font-bold" style="background:#fff;border:1px solid #E7DCF2;color:#6B6577">{t.name}</span>
            )
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 px-6 bg-white">
      <div class="max-w-2xl mx-auto">
        <p class="text-xs font-black uppercase tracking-widest mb-2" style="color:#C2A76F">Be the reason Good Circles comes to {county.name}</p>
        <h2 class="text-3xl font-black text-slate-900 mb-3" style="letter-spacing:-0.02em">Request Good Circles in the {county.name} area</h2>
        <p class="text-slate-500 mb-6" style="font-family:'Fira Sans',sans-serif">Every request is a vote. The more {county.name} neighbors who ask, the sooner we launch.</p>
        <div class="p-6 rounded-3xl" style="background:#FBF7FE;border:1px solid #E7DCF2">
          <RequestCityForm client:load defaultCity={county.seat} defaultState={county.st} />
        </div>
      </div>
    </section>

    <StartBusinessCta place={county.name} utmContent={`county-${county.stateSlug}-${county.slug}`} />

    <FaqList faqs={FAQS} heading={`${county.name} FAQ`} />
  </main>
  <Footer />
</Base>
