---
// Shared header for money/content pages: brand-purple gradient, one H1, and
// the answer-first block as the FIRST body copy in the DOM (snippet/AI bait).
interface Props {
  eyebrow?: string;
  h1: string;
  badge?: string;
}
const { eyebrow, h1, badge } = Astro.props;
---

<header
  class="relative overflow-hidden px-6 pt-32 pb-16"
  style="background:linear-gradient(150deg,#241247 0%,#4B2E84 58%,#7851A9 100%)"
>
  <div class="max-w-3xl mx-auto relative z-10">
    {badge && (
      <p
        class="inline-block px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-widest text-white mb-6"
        style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.25)"
      >
        {badge}
      </p>
    )}
    {eyebrow && (
      <p class="text-xs font-black uppercase tracking-widest mb-4" style="color:#FADC9C">
        {eyebrow}
      </p>
    )}
    <h1
      class="font-black text-white mb-6"
      style="font-size:clamp(2rem,5.5vw,3.4rem);letter-spacing:-0.02em;line-height:1.05"
    >
      {h1}
    </h1>
    <div
      class="text-white/90 text-lg leading-relaxed rounded-2xl p-6"
      style="background:rgba(255,255,255,0.09);border:1px solid rgba(255,255,255,0.18);font-family:'Fira Sans',sans-serif"
    >
      <slot name="answer" />
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      <slot name="ctas" />
    </div>
  </div>
  <div
    class="absolute rounded-full pointer-events-none"
    style="right:-130px;top:-130px;width:480px;height:480px;background:radial-gradient(circle,rgba(250,220,156,.26),rgba(250,220,156,0) 65%)"
    aria-hidden="true"
  >
  </div>
</header>
