---
// "As featured in" credibility strip. Unlinked by design: the underlying
// coverage (March/April 2023) is about the founder's prior venture, predates
// the current goodcircles.org model, and links to a domain no longer
// controlled — so we show the recognizable outlet names as social proof
// without linking to outdated articles. Only outlets with a verified live
// placement are listed (Yahoo Finance, Star Tribune, Atlanta Wire — verified
// 2026-06-12).
const OUTLETS = ['Yahoo Finance', 'Star Tribune', 'Atlanta Wire'];
---

<section class="py-10 px-6 bg-white border-t border-b" style="border-color:#F1EAF8">
  <div class="max-w-4xl mx-auto text-center">
    <p class="text-[11px] font-black uppercase tracking-[0.25em] mb-5" style="color:#C2A76F">
      As featured in
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {OUTLETS.map((name) => (
        <span
          class="font-black text-slate-400"
          style="font-family:'Montserrat',sans-serif;font-size:clamp(1rem,2.4vw,1.35rem);letter-spacing:-0.01em"
        >
          {name}
        </span>
      ))}
    </div>
  </div>
</section>
